#!/usr/bin/env bash
# Git prepare-commit-msg hook
# Reads .context-index/.session-tracking.jsonl and appends
# Spec:, Plan-task:, and Session: trailers to the commit message.
# ALWAYS exits 0 — never blocks a commit.

set -uo pipefail

COMMIT_MSG_FILE="${1:-}"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

TRACKING_FILE=".context-index/.session-tracking.jsonl"

# Exit silently if tracking file is missing or empty
if [ ! -f "$TRACKING_FILE" ] || [ ! -s "$TRACKING_FILE" ]; then
  exit 0
fi

# Read the current commit message
CURRENT_MSG=$(cat "$COMMIT_MSG_FILE")

# Extract unique spec paths from JSONL
SPECS=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  const specs = new Set();
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (Array.isArray(obj.specs)) {
        for (const s of obj.specs) {
          // Sanitize: strip newlines, validate path-like pattern
          const clean = String(s).replace(/[\r\n]/g, "").trim();
          if (clean && /^[\w.\/\-]+$/.test(clean)) {
            specs.add(clean);
          }
        }
      }
    } catch {}
  }
  for (const s of specs) console.log(s);
' "$TRACKING_FILE" 2>/dev/null) || SPECS=""

# Extract unique session IDs (if present)
SESSIONS=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  const sessions = new Set();
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (obj.sessionId) {
        const clean = String(obj.sessionId).replace(/[\r\n]/g, "").trim();
        if (clean && /^[\w\-]+$/.test(clean)) {
          sessions.add(clean);
        }
      }
    } catch {}
  }
  for (const s of sessions) console.log(s);
' "$TRACKING_FILE" 2>/dev/null) || SESSIONS=""

# Extract unique plan-task numbers (if present)
TASKS=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  const tasks = new Set();
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (obj.planTask != null) {
        const clean = String(obj.planTask).replace(/[\r\n]/g, "").trim();
        if (clean && /^[\w\-\.]+$/.test(clean)) {
          tasks.add(clean);
        }
      }
    } catch {}
  }
  for (const t of tasks) console.log(t);
' "$TRACKING_FILE" 2>/dev/null) || TASKS=""

# Extract unique issue IDs (if present)
ISSUES=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  const issues = new Set();
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (obj.issue) {
        const clean = String(obj.issue).replace(/[\r\n]/g, "").trim();
        if (clean && /^[\w\-]+$/.test(clean)) {
          issues.add(clean);
        }
      }
    } catch {}
  }
  for (const i of issues) console.log(i);
' "$TRACKING_FILE" 2>/dev/null) || ISSUES=""

# Determine author type from session JSONL
AUTHOR_TYPE=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  let hasSessionId = false;
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (obj.session_id) { hasSessionId = true; break; }
    } catch {}
  }
  console.log(hasSessionId ? "agent/claude-code" : "human");
' "$TRACKING_FILE" 2>/dev/null) || AUTHOR_TYPE=""

# Extract operator identity from JSONL (most recent entry with operator field)
OPERATOR=$(node -e '
  const fs = require("fs");
  const lines = fs.readFileSync(process.argv[1], "utf8").trim().split("\n");
  let op = "";
  for (const line of lines) {
    try {
      const obj = JSON.parse(line);
      if (obj.operator) {
        const clean = String(obj.operator).replace(/[\r\n]/g, "").trim();
        if (clean && /^[\w.\-]+\/[\w.\-]+$/.test(clean)) op = clean;
      }
    } catch {}
  }
  if (op) console.log(op);
' "$TRACKING_FILE" 2>/dev/null) || OPERATOR=""

# Function to check if a trailer already exists in the commit message
trailer_exists() {
  local trailer="$1"
  grep -qF "$trailer" "$COMMIT_MSG_FILE" 2>/dev/null
}

# Collapse blank lines within a trailing pure-trailer run. A commit message
# assembled elsewhere (e.g. a HEREDOC that writes `Spec:` and `Plan-task:` as
# separate paragraphs) can arrive with a blank line INSIDE what should be one
# trailer block:
#   Spec: .context-index/specs/features/x/y.spec.md
#
#   Plan-task: 3
# `git interpret-trailers --parse` only recognizes the LAST contiguous block
# as trailers, so the blank line silently drops Spec: from every trailer
# reader (retro, hygiene, etc.) even though Plan-task: survives. The
# last-line check below only inspects one line, so it can't see this — it
# would happily append Author-type:/Operator: after "Plan-task: 3" and
# report success while Spec: stays orphaned.
#
# Only touches a trailing run where EVERY non-blank line already looks
# trailer-shaped (`Key: value`) — body prose is never in scope, since the
# scan stops at the first non-blank line that doesn't match.
collapse_trailer_gaps() {
  awk '
    { lines[NR] = $0; last = NR }
    END {
      start = last + 1
      for (i = last; i >= 1; i--) {
        line = lines[i]
        if (line ~ /^[ \t]*$/) continue
        if (line ~ /^[A-Za-z][A-Za-z0-9_-]*: /) { start = i; continue }
        break
      }
      for (i = 1; i < start; i++) print lines[i]
      for (i = start; i <= last; i++) {
        line = lines[i]
        if (line ~ /^[ \t]*$/) continue
        print line
      }
    }
  ' "$COMMIT_MSG_FILE" > "$COMMIT_MSG_FILE.tmp" && mv "$COMMIT_MSG_FILE.tmp" "$COMMIT_MSG_FILE"
}
collapse_trailer_gaps

# Build trailers to append
TRAILERS=""

while IFS= read -r spec; do
  [ -z "$spec" ] && continue
  TRAILER="Spec: $spec"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
done <<< "$SPECS"

while IFS= read -r task; do
  [ -z "$task" ] && continue
  TRAILER="Plan-task: $task"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
done <<< "$TASKS"

while IFS= read -r session; do
  [ -z "$session" ] && continue
  TRAILER="Session: $session"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
done <<< "$SESSIONS"

while IFS= read -r issue; do
  [ -z "$issue" ] && continue
  TRAILER="Issue: $issue"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
done <<< "$ISSUES"

if [ -n "$AUTHOR_TYPE" ]; then
  TRAILER="Author-type: $AUTHOR_TYPE"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
fi

if [ -n "$OPERATOR" ]; then
  TRAILER="Operator: $OPERATOR"
  if ! trailer_exists "$TRAILER"; then
    TRAILERS="${TRAILERS}${TRAILER}"$'\n'
  fi
fi

# Append trailers if any. If the body already ends with a trailer-formatted
# line (e.g. `Spec:` / `Plan-task:` injected via HEREDOC), append the new
# trailers WITHOUT a leading blank line — otherwise the existing trailer
# block becomes a separate paragraph and `git interpret-trailers --parse`
# only returns the last block, silently dropping the body trailers.
# See issue-526 (cursor-provider retro 2026-05-19).
if [ -n "$TRAILERS" ]; then
  LAST_LINE=$(awk 'NF{l=$0} END{print l}' "$COMMIT_MSG_FILE")
  if printf '%s' "$LAST_LINE" | grep -qE '^[A-Za-z][A-Za-z0-9_-]*: '; then
    # Existing trailer block — append directly without a blank-line separator
    printf '%s' "$TRAILERS" >> "$COMMIT_MSG_FILE"
  else
    # No existing trailer block — start a new paragraph
    printf '\n%s' "$TRAILERS" >> "$COMMIT_MSG_FILE"
  fi
fi

exit 0
