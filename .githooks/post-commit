#!/usr/bin/env bash
# Git post-commit hook
# Writes an enriched session summary using the commit message,
# changed files, and session tracking JSONL.
# Always exits 0 — never blocks.

set -uo pipefail

# Guard: require node
command -v node >/dev/null 2>&1 || exit 0

# Read commit info
COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null) || exit 0
COMMIT_DATE=$(git log -1 --format='%aI' "$COMMIT_HASH" 2>/dev/null) || exit 0

# Extract Spec: trailers from the commit message
SPECS_TOUCHED=$(git log -1 --format='%(trailers:key=Spec,valueonly)' "$COMMIT_HASH" 2>/dev/null | tr '\n' ',' | sed 's/,$//' || echo "")

# Get commit subject and body
COMMIT_SUBJECT=$(git log -1 --format='%s' "$COMMIT_HASH" 2>/dev/null || echo "")
COMMIT_BODY=$(git log -1 --format='%b' "$COMMIT_HASH" 2>/dev/null || echo "")

# Get files changed in this commit
CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r "$COMMIT_HASH" 2>/dev/null || echo "")

# Self-skip guard: when every changed file is inside `.context-index/sessions/`,
# exit without writing a capture. Prevents the "1 commit -> 1 capture -> 1 commit"
# amplification when agents commit in-session.
# Spec: .context-index/specs/features/session-awareness/post-commit-self-skip.spec.md
if [ -n "$CHANGED_FILES" ]; then
  SESSIONS_ONLY=1
  while IFS= read -r CHANGED_PATH; do
    [ -z "$CHANGED_PATH" ] && continue
    case "$CHANGED_PATH" in
      .context-index/sessions/*) ;;
      *) SESSIONS_ONLY=0; break ;;
    esac
  done <<< "$CHANGED_FILES"

  if [ "$SESSIONS_ONLY" = "1" ]; then
    echo "session-capture skipped: sessions-only commit" >&2
    exit 0
  fi
fi

# Determine output directory
OUTPUT_DIR=".context-index/sessions"
TRACKING_FILE=".context-index/.session-tracking.jsonl"

# Call session-summary writer with enriched content
node --input-type=module -e "
  import { writeSummary } from './lib/session-summary.mjs';
  import { readFileSync, writeFileSync } from 'fs';

  const metadata = {
    date: '${COMMIT_DATE}'.slice(0, 10),
    type: 'commit',
    mode: 'auto',
    agent: 'git-hook',
    specsTouched: '${SPECS_TOUCHED}'.split(',').filter(Boolean),
    commits: ['${COMMIT_HASH}'],
  };

  // Intent = commit subject + body
  const subject = $(printf '%s' "$COMMIT_SUBJECT" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>console.log(JSON.stringify(d.trim())))');
  const body = $(printf '%s' "$COMMIT_BODY" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>console.log(JSON.stringify(d.trim())))');

  // Changed files
  const changedFiles = $(printf '%s' "$CHANGED_FILES" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>console.log(JSON.stringify(d.trim())))');

  // Session activity from tracking JSONL
  let sessionLines = '';
  try {
    sessionLines = readFileSync('${TRACKING_FILE}', 'utf8').trim();
  } catch {}

  const sections = ['## Intent', '', subject];
  if (body) {
    sections.push('', body);
  }

  sections.push('', '## Outcome', '');

  // Files changed
  if (changedFiles) {
    const files = changedFiles.split('\n').filter(Boolean);
    sections.push('### Files changed');
    for (const f of files) {
      sections.push('- ' + f);
    }
    sections.push('');
  }

  // Session activity
  if (sessionLines) {
    const toolCounts = {};
    const filesTouched = new Set();
    for (const line of sessionLines.split('\n')) {
      try {
        const obj = JSON.parse(line);
        const tool = obj.tool || 'unknown';
        toolCounts[tool] = (toolCounts[tool] || 0) + 1;
        if (Array.isArray(obj.files)) {
          for (const f of obj.files) if (f) filesTouched.add(f);
        }
      } catch {}
    }
    const counts = Object.entries(toolCounts)
      .sort((a, b) => b[1] - a[1])
      .map(([tool, n]) => n + ' ' + tool)
      .join(', ');
    sections.push('### Session activity');
    sections.push('- Tool calls: ' + counts);
    if (filesTouched.size > 0) {
      sections.push('- Files touched: ' + [...filesTouched].join(', '));
    }
    sections.push('');
  }

  const condensed = sections.join('\n');
  await writeSummary(condensed, metadata, '${OUTPUT_DIR}');

  // Clear tracking JSONL for next session
  if (sessionLines) {
    try { writeFileSync('${TRACKING_FILE}', '', 'utf8'); } catch {}
  }
" 2>/dev/null || true

exit 0
