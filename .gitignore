node_modules/
.DS_Store
*.log

# Claude Code local settings
.claude/settings.local.json

# NPM package archives
*.tgz

# Skill-creator workspace directories
skills/*-workspace/
skills/*/evals/

# adev hygiene reports (generated, not committed)
.context-index/hygiene/
.context-index/packets/

# Context-preflight session flag (ephemeral, cleared each session)
.context-index/.context-preflight-ok

# Retired beads sidecar. adev no longer writes it — the adev id lives in br's
# `external_ref` — but a pre-existing one is migrated into beads and renamed
# aside on first use, so both forms stay out of git.
.beads-map.json
.beads-map.json.migrated-*
.context-index/tasks/tasks.json
.context-index/tasks/tasks.json.migrated-*

# Build orchestrator resume state (ephemeral — survives across sessions but never committed)
# Per-spec event logs (*.jsonl) ARE committed; only the *.json build-state files are ignored.
.context-index/lifecycle-state/*.json
# Legacy path retained for pre-migration projects (see ADR / one-shot-migration-tool.spec.md).
.context-index/build-state/*.json

# Environment variables — local overrides, never committed
.env
.env.local
.env.*.local

# Eval cached repos (cloned on demand, large)
tests/evals/repomap/.cache/

# Eval generated data (regenerate with: npm run eval / eval:skill-compression)
tests/evals/repomap/*/
tests/evals/skill-compression/outputs/

# Viz build output (regenerate with: node viz/build.mjs)
viz/dist/

.context-index/.token-cursor.json
.context-index/.reminder-counter
.context-index/.session-tracking.jsonl
.context-index/user-config

# Execution state (transient per-session resume cursor — owned by lib/execution-state.mjs).
# Committed copies appeared on cursor-provider branches due to /adev:implement
# staging the file; ignore here so future builds don't repeat that mistake.
.context-index/.execution-state.json

# Prototype artifacts (adev)
.adev/

# Claude Code worktrees (ephemeral agent workspaces)
.claude/worktrees/

# Claude Code scheduled-tasks lock (runtime state)
.claude/scheduled_tasks.lock

# JSON issue board CAS lock + temp files (runtime state from lib/issues/json-adapter.mjs).
# Lock file is normally created+released within a single mutator call but may
# survive process kill (SIGKILL, OS crash). Temp files are normally renamed
# into place but may persist if the rename step fails. Committing either
# would break writes on every clone (stale lock → repeated STALE_BOARD_WRITE;
# stray .tmp is benign but pollutes diffs). See concurrent-write-protection.spec.md.
.context-index/tasks/tasks.json.lock
.context-index/tasks/tasks.json.*.tmp

# Backend-migration resume state. Written per-item by `adev issues migrate`
# during a json↔beads conversion; removed on successful completion. Committing
# would surface as a stale "wedged migration" on every clone and force the
# next migration into a refuse-on-mismatch path. See
# backend-migration.spec.md Postcondition 6 and the `.migrate-state.json`
# schema documented in lib/cli/issues-migrate.mjs.
.context-index/tasks/.migrate-state.json

# Lifecycle gate advisory counter (runtime state)
.context-index/.advisory-counter

# Incremental-artifact writes (.partial + atomic-rename pattern).
# Per incremental-artifact-writes.spec.md, *.partial files represent
# in-progress agent authoring committed via atomic rename to the final
# filename. *.partial.lock files are sidecar coordination state holding
# {pid, started_at} for steal-on-stale detection. Both are runtime state
# and never committed — a committed orphan would surface as a "wedged
# artifact" on every clone. (Analogous treatment to tasks.json.lock above.)
*.partial
*.partial.lock

# Skill extension layers managed by `adev extension install` — not committed.
.context-index/skill-extensions/_*/

# >>> adev:gitignore >>>
# hygiene reports (regenerated)
.context-index/hygiene/
# review packets (regenerated)
.context-index/packets/
# session-tracking cursor
.context-index/.token-cursor.json
# issue-reminder counter
.context-index/.reminder-counter
# session telemetry
.context-index/.session-tracking.jsonl
# local user config override
.context-index/user-config
# preflight session flag
.context-index/.context-preflight-ok
# execution state (transient)
.context-index/.execution-state.json
# lifecycle-gate advisory counter
.context-index/.advisory-counter
# build-state JSON (jsonl event logs ARE committed; only *.json build-state ignored) — SA-1
.context-index/lifecycle-state/*.json
# legacy build-state (pre-rename)
.context-index/build-state/*.json
# issue-board CAS lock
.context-index/tasks/tasks.json.lock
# issue-board atomic-write temp
.context-index/tasks/tasks.json.*.tmp
# backend-migration resume state
.context-index/tasks/.migrate-state.json
# beads board — linked git worktree against beads-board, not main's tree
.beads/
# board-migrate resume checkpoint
.context-index/tasks/.board-migrate-state.json
# incremental artifact write — satisfies cross-cutting/incremental-artifact-writes:236
*.partial
# incremental artifact lock
*.partial.lock
# gitignore-installer atomic-write temp (SEC-2)
.gitignore.*.tmp
# prototype workspace
.adev/
# chained-hook bodies (regenerated by adev install; wrapper is committed, these are not)
.githooks/*.adev
# <<< adev:gitignore <<<
