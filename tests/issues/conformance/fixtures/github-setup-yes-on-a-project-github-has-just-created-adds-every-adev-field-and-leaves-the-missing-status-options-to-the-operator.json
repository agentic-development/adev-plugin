      "query": "query ProjectItems($projectId: ID!, $after: String) {\n  node(id: $projectId) {\n    ... on ProjectV2 {\n      items(first: 100, after: $after) {\n        totalCount\n        pageInfo { hasNextPage endCursor }\n        nodes {\n          id\n          type\n          fieldValues(first: 50) {\n            nodes {\n              __typename\n              ... on ProjectV2ItemFieldTextValue { text field { ... on ProjectV2FieldCommon { name } } }\n              ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } }\n              ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2FieldCommon { name } } }\n            }\n          }\n          content {\n            __typename\n            ... on Issue {\n              id\n              number\n              title\n              body\n              state\n              url\n              createdAt\n              updatedAt\n              repository { name owner { login } issueTypes(first: 1) { totalCount } }\n              issueType { name }\n              labels(first: 100) { totalCount nodes { name } }\n              milestone { title }\n              parent { number state repository { name owner { login } } }\n              blockedBy(first: 100) { totalCount pageInfo { hasNextPage endCursor } nodes { number state repository { name owner { login } } } }\n              subIssues(first: 100) { totalCount pageInfo { hasNextPage endCursor } nodes { number state repository { name owner { login } } } }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n",
