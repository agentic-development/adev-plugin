diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..109e21e
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,137 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-1';
+const OTHER_SECRET = 'test-secret-2';
+
+function hmac(text, secret) {
+  return createHmac('sha256', secret).update(text).digest('base64url');
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of the first part)', () => {
+  const firstPart = 'eyJzdWIiOiJ1MSJ9';
+  const expected = `${firstPart}.${hmac(firstPart, SECRET)}`;
+  assert.equal(signToken({ sub: 'u1' }, SECRET), expected);
+});
+
+test('signToken uses the URL-safe alphabet with no padding', () => {
+  // Standard base64 of {"d":"?????>"} is eyJkIjoiPz8/Pz8+In0= (contains '/', '+', '=').
+  const firstPart = 'eyJkIjoiPz8_Pz8-In0';
+  const token = signToken({ d: '?????>' }, SECRET);
+  assert.equal(token, `${firstPart}.${hmac(firstPart, SECRET)}`);
+  assert.match(token, /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
+});
+
+test('verifyToken returns the payload of a token signed with the same secret', () => {
+  const payload = {
+    sub: 'u1',
+    n: 42,
+    nested: { roles: ['admin', 'user'], depth: { ok: true, none: null } },
+    list: [1, 'two', { three: 3 }],
+  };
+  assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), payload);
+});
+
+test('verifyToken round-trips non-object JSON payloads', () => {
+  assert.deepEqual(verifyToken(signToken([1, 2, 3], SECRET), SECRET), [1, 2, 3]);
+  assert.equal(verifyToken(signToken('hello', SECRET), SECRET), 'hello');
+  assert.equal(verifyToken(signToken(7, SECRET), SECRET), 7);
+});
+
+const U1_BODY = 'eyJzdWIiOiJ1MSJ9'; // {"sub":"u1"}
+const U2_BODY = 'eyJzdWIiOiJ1MiJ9'; // {"sub":"u2"}
+
+function flipLastChar(text) {
+  const last = text.at(-1);
+  return text.slice(0, -1) + (last === 'A' ? 'B' : 'A');
+}
+
+test('verifyToken returns null for a token signed with a different secret', () => {
+  assert.equal(verifyToken(signToken({ sub: 'u1' }, OTHER_SECRET), SECRET), null);
+});
+
+test('verifyToken returns null when the payload part is tampered', () => {
+  const token = `${U2_BODY}.${hmac(U1_BODY, SECRET)}`;
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null when one signature character is changed', () => {
+  const token = `${U1_BODY}.${flipLastChar(hmac(U1_BODY, SECRET))}`;
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null when a signature from a different payload is swapped in', () => {
+  const otherSig = signToken({ sub: 'u2' }, SECRET).split('.')[1];
+  assert.equal(verifyToken(`${U1_BODY}.${otherSig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated signature (length mismatch)', () => {
+  const token = `${U1_BODY}.${hmac(U1_BODY, SECRET).slice(0, -1)}`;
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for an extended signature (length mismatch)', () => {
+  const token = `${U1_BODY}.${hmac(U1_BODY, SECRET)}A`;
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a token with no dot', () => {
+  assert.equal(verifyToken('abc', SECRET), null);
+  assert.equal(verifyToken(U1_BODY, SECRET), null);
+});
+
+test('verifyToken returns null for a token with more than one dot', () => {
+  assert.equal(verifyToken('a.b.c', SECRET), null);
+  const valid = `${U1_BODY}.${hmac(U1_BODY, SECRET)}`;
+  assert.equal(verifyToken(`${valid}.extra`, SECRET), null);
+  assert.equal(verifyToken(`${valid}.`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty payload part', () => {
+  assert.equal(verifyToken('.sig', SECRET), null);
+  assert.equal(verifyToken(`.${hmac('', SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty signature part', () => {
+  assert.equal(verifyToken('payload.', SECRET), null);
+  assert.equal(verifyToken(`${U1_BODY}.`, SECRET), null);
+});
+
+test('verifyToken returns null for non-string tokens', () => {
+  assert.equal(verifyToken(undefined, SECRET), null);
+  assert.equal(verifyToken(null, SECRET), null);
+  assert.equal(verifyToken(123, SECRET), null);
+  assert.equal(verifyToken({}, SECRET), null);
+  assert.equal(verifyToken(['a', 'b'], SECRET), null);
+});
+
+test('verifyToken returns null for a valid signature over a first part that is not JSON', () => {
+  const notJson = 'bm90IGpzb24'; // "not json"
+  const truncatedJson = 'eyJzdWIiOg'; // {"sub":
+  const garbage = 'abc';
+  assert.equal(verifyToken(`${notJson}.${hmac(notJson, SECRET)}`, SECRET), null);
+  assert.equal(verifyToken(`${truncatedJson}.${hmac(truncatedJson, SECRET)}`, SECRET), null);
+  assert.equal(verifyToken(`${garbage}.${hmac(garbage, SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a non-canonical signature that decodes to the same bytes', () => {
+  const sig = hmac(U1_BODY, SECRET);
+  assert.equal(sig.at(-1), 'w');
+  // 'w' and 'x' differ only in the 2 unused trailing bits of a 43-char base64url digest.
+  const variant = `${sig.slice(0, -1)}x`;
+  assert.deepEqual(Buffer.from(variant, 'base64url'), Buffer.from(sig, 'base64url'));
+  assert.equal(verifyToken(`${U1_BODY}.${variant}`, SECRET), null);
+});
+
+test('verifyToken returns null instead of throwing when the secret is not a valid key', () => {
+  const token = `${U1_BODY}.${hmac(U1_BODY, SECRET)}`;
+  assert.equal(verifyToken(token, undefined), null);
+  assert.equal(verifyToken(token, null), null);
+  assert.equal(verifyToken(token, 123), null);
+});
