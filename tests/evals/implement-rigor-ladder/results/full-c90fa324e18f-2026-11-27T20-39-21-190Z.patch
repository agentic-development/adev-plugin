index 1bfc471..7314af9 100644
--- a/tests/discount.test.mjs
+++ b/tests/discount.test.mjs
@@ -11,3 +11,67 @@ test('a fixed coupon subtracts its amount', () => {
 test('an expired coupon leaves the price unchanged', () => {
   assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: 500 }, NOW), 2000);
 });
+
+// --- BEH-4: percent coupons, floor at 0, expiry boundary, COUPON_INVALID ---
+
+function assertCouponInvalid(fn) {
+  assert.throws(fn, (err) => {
+    assert.ok(err instanceof Error);
+    assert.equal(err.code, 'COUPON_INVALID');
+    return true;
+  });
+}
+
+test('a percent coupon subtracts that percentage of the price', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 2_000 }, NOW), 1500);
+});
+
+test('a percent discount is floored (999 at 10%: discount 99, not 100)', () => {
+  assert.equal(applyDiscount(999, { kind: 'percent', amount: 10, expiresAt: 2_000 }, NOW), 900);
+});
+
+test('a percent coupon of 100 brings the price to 0', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 100, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a percent coupon above 100 clamps the price to 0, not negative', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 150, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a fixed coupon larger than the price clamps the price to 0', () => {
+  assert.equal(applyDiscount(300, { kind: 'fixed', amount: 500, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a fixed coupon equal to the price brings the price to 0', () => {
+  assert.equal(applyDiscount(500, { kind: 'fixed', amount: 500, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a fixed coupon expiring exactly at now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: NOW }, NOW), 2000);
+});
+
+test('a percent coupon expiring exactly at now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: NOW }, NOW), 2000);
+});
+
+test('an expired percent coupon leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 500 }, NOW), 2000);
+});
+
+test('a coupon expiring just after now still applies', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: NOW + 1 }, NOW), 1500);
+  assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: NOW + 1 }, NOW), 1500);
+});
+
+test('an unknown coupon kind throws COUPON_INVALID', () => {
+  assertCouponInvalid(() => applyDiscount(2000, { kind: 'bogus', amount: 10, expiresAt: 2_000 }, NOW));
+});
+
+test('a missing coupon kind throws COUPON_INVALID', () => {
+  assertCouponInvalid(() => applyDiscount(2000, { amount: 10, expiresAt: 2_000 }, NOW));
+  assertCouponInvalid(() => applyDiscount(2000, { kind: undefined, amount: 10, expiresAt: 2_000 }, NOW));
+});
+
+test('an unknown coupon kind throws COUPON_INVALID even when the coupon is expired', () => {
+  assertCouponInvalid(() => applyDiscount(2000, { kind: 'bogus', amount: 10, expiresAt: 500 }, NOW));
+});
