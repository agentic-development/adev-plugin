+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const catalog = [
+  { id: 'p1', label: 'Blue Mug!! XL', priceCents: 1299 },
+  { id: 'p2', label: '  Tea Pot ', priceCents: 2500 },
+  { id: 'p3', label: 'Spoon & Fork Set', priceCents: 450 },
+  { id: 'p4', label: 'Free--Sample', priceCents: 0 },
+  { id: 'p5', label: 'Café Cup 2.0', priceCents: 799 },
+];
+
+test('listHandler returns the formatted first page of a multi-page catalog', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p1', label: 'Blue Mug!! XL', slug: 'blue-mug-xl', price: { cents: 1299, currency: 'USD' } },
+        { id: 'p2', label: '  Tea Pot ', slug: 'tea-pot', price: { cents: 2500, currency: 'USD' } },
+      ],
+      page: 1,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('dispatch("list") returns the formatted first page of a multi-page catalog', () => {
+  assert.deepEqual(dispatch('list', { page: 1, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p1', label: 'Blue Mug!! XL', slug: 'blue-mug-xl', price: { cents: 1299, currency: 'USD' } },
+        { id: 'p2', label: '  Tea Pot ', slug: 'tea-pot', price: { cents: 2500, currency: 'USD' } },
+      ],
+      page: 1,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('dispatch("list") returns a partial last page', () => {
+  assert.deepEqual(dispatch('list', { page: 3, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p5', label: 'Café Cup 2.0', slug: 'caf-cup-2-0', price: { cents: 799, currency: 'USD' } },
+      ],
+      page: 3,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('dispatch("list") returns the middle page', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p3', label: 'Spoon & Fork Set', slug: 'spoon-fork-set', price: { cents: 450, currency: 'USD' } },
+        { id: 'p4', label: 'Free--Sample', slug: 'free-sample', price: { cents: 0, currency: 'USD' } },
+      ],
+      page: 2,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('dispatch("list") for a page past the end is a 200 with no items', () => {
+  assert.deepEqual(dispatch('list', { page: 4, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 4, pageCount: 3, total: 5 },
+  });
+});
+
+test('dispatch("list") for page 0 is a 200 with no items', () => {
+  assert.deepEqual(dispatch('list', { page: 0, pageSize: 2 }, { items: catalog, currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 0, pageCount: 3, total: 5 },
+  });
+});
+
+test('dispatch("list") over an empty catalog', () => {
+  assert.deepEqual(dispatch('list', { page: 1, pageSize: 2 }, { items: [], currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 1, pageCount: 0, total: 0 },
+  });
+});
+
+test('dispatch("list") carries the currency into every formatted item', () => {
+  assert.deepEqual(dispatch('list', { page: 1, pageSize: 5 }, { items: catalog, currency: 'EUR' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p1', label: 'Blue Mug!! XL', slug: 'blue-mug-xl', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'p2', label: '  Tea Pot ', slug: 'tea-pot', price: { cents: 2500, currency: 'EUR' } },
+        { id: 'p3', label: 'Spoon & Fork Set', slug: 'spoon-fork-set', price: { cents: 450, currency: 'EUR' } },
+        { id: 'p4', label: 'Free--Sample', slug: 'free-sample', price: { cents: 0, currency: 'EUR' } },
+        { id: 'p5', label: 'Café Cup 2.0', slug: 'caf-cup-2-0', price: { cents: 799, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 1,
+      total: 5,
+    },
+  });
+});
+
+test('listHandler body has exactly the keys items, page, pageCount, total', () => {
+  const out = listHandler({ page: 2, pageSize: 2 }, { items: catalog, currency: 'GBP' });
+  assert.deepEqual(Object.keys(out), ['status', 'body']);
+  assert.deepEqual(Object.keys(out.body), ['items', 'page', 'pageCount', 'total']);
+});
+
+test('dispatch("list") returns exactly what listHandler returns for the same input', () => {
+  const query = { page: 2, pageSize: 3 };
+  const ctx = { items: catalog, currency: 'GBP' };
+  const expected = {
+    status: 200,
+    body: {
+      items: [
+        { id: 'p4', label: 'Free--Sample', slug: 'free-sample', price: { cents: 0, currency: 'GBP' } },
+        { id: 'p5', label: 'Café Cup 2.0', slug: 'caf-cup-2-0', price: { cents: 799, currency: 'GBP' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 5,
+    },
+  };
+  assert.deepEqual(listHandler(query, ctx), expected);
+  assert.deepEqual(dispatch('list', query, ctx), expected);
+});
+
+test('handlers.list is listHandler', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("health") still works and unregistered names are still a 404', () => {
+  assert.deepEqual(dispatch('health'), { status: 200, body: { ok: true } });
+  assert.deepEqual(dispatch('nope'), { status: 404 });
+});
