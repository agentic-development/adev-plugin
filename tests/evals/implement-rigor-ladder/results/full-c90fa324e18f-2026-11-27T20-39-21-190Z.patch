diff --git a/tests/slug.test.mjs b/tests/slug.test.mjs
new file mode 100644
index 0000000..051695e
--- /dev/null
+++ b/tests/slug.test.mjs
@@ -0,0 +1,39 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify turns a label into a lowercase hyphenated slug', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify collapses a multi-character run of separators into a single hyphen', () => {
+  assert.equal(slugify('red  &  green'), 'red-green');
+});
+
+test('slugify trims leading and trailing hyphens', () => {
+  assert.equal(slugify('  -Blue Mug!- '), 'blue-mug');
+});
+
+test('slugify lowercases uppercase letters instead of replacing them', () => {
+  assert.equal(slugify('ABC'), 'abc');
+});
+
+test('slugify preserves digits', () => {
+  assert.equal(slugify('Mug 2000 XL'), 'mug-2000-xl');
+});
+
+test('slugify returns an empty string for an all-separator input', () => {
+  assert.equal(slugify(' -!_ '), '');
+});
+
+test('slugify treats non-ASCII letters as separators', () => {
+  assert.equal(slugify('Café'), 'caf');
+});
+
+test('slugify leaves an already-slugged input unchanged', () => {
+  assert.equal(slugify('blue-mug-2'), 'blue-mug-2');
+});
+
+test('slugify returns an empty string for an empty string', () => {
+  assert.equal(slugify(''), '');
+});
