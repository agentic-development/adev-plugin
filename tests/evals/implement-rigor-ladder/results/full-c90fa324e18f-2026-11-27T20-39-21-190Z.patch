+test('parseConfig rejects JSON null with CONFIG_INVALID', () => {
+  assertConfigInvalid('null');
+});
+
+test('parseConfig rejects a JSON array with CONFIG_INVALID', () => {
+  assertConfigInvalid('[]');
+});
+
+test('parseConfig rejects JSON primitives with CONFIG_INVALID', () => {
+  assertConfigInvalid('42');
+  assertConfigInvalid('"text"');
+  assertConfigInvalid('true');
+});
+
+test('parseConfig rejects pageSize 0 with CONFIG_INVALID', () => {
+  assertConfigInvalid('{"pageSize":0}');
+});
+
+test('parseConfig rejects negative pageSize with CONFIG_INVALID', () => {
+  assertConfigInvalid('{"pageSize":-5}');
+});
+
+test('parseConfig rejects non-integer pageSize with CONFIG_INVALID', () => {
