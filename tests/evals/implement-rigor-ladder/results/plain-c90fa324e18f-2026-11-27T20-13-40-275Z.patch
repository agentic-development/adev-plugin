@@ -11,3 +11,36 @@ test('a fixed coupon subtracts its amount', () => {
 test('an expired coupon leaves the price unchanged', () => {
   assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: 500 }, NOW), 2000);
 });
+
+test('a coupon expiring exactly now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: NOW }, NOW), 2000);
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 50, expiresAt: NOW }, NOW), 2000);
+});
+
+test('a fixed coupon larger than the price floors the result at 0', () => {
+  assert.equal(applyDiscount(300, { kind: 'fixed', amount: 500, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a percent coupon subtracts the floored percentage', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 2_000 }, NOW), 1500);
+  // 999 * 15 / 100 = 149.85 -> 149 off
+  assert.equal(applyDiscount(999, { kind: 'percent', amount: 15, expiresAt: 2_000 }, NOW), 850);
+});
+
+test('a percent coupon over 100 floors the result at 0', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 150, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('an unknown coupon kind throws COUPON_INVALID', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: 'bogo', amount: 1, expiresAt: 2_000 }, NOW),
+    (err) => err instanceof Error && err.code === 'COUPON_INVALID',
+  );
+});
+
+test('an unknown coupon kind throws COUPON_INVALID even when expired', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: 'bogo', amount: 1, expiresAt: 500 }, NOW),
+    { code: 'COUPON_INVALID' },
+  );
+});
