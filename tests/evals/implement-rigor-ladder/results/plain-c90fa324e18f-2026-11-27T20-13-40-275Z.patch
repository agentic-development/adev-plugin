--- /dev/null
+++ b/src/slug.mjs
@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..31a0760
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 's3cret';
+const PAYLOAD = { sub: 'user-1', role: 'admin' };
+
+test('signToken produces base64url(JSON).base64url(HMAC-SHA256)', () => {
+  const body = Buffer.from(JSON.stringify(PAYLOAD)).toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(signToken(PAYLOAD, SECRET), `${body}.${sig}`);
+});
+
+test('signToken output uses only base64url characters', () => {
+  assert.match(signToken({ s: 'ÿþ>>>???' }, SECRET), /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
+});
+
+test('verifyToken round-trips the payload', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), PAYLOAD);
+});
+
+test('verifyToken returns null for the wrong secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), 'other'), null);
+});
+
+test('verifyToken returns null for a tampered payload', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forged = Buffer.from(JSON.stringify({ ...PAYLOAD, role: 'root' })).toString('base64url');
+  assert.equal(verifyToken(`${forged}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered or truncated signature', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  const last = token.at(-1) === 'A' ? 'B' : 'A';
+  assert.equal(verifyToken(token.slice(0, -1) + last, SECRET), null);
+  assert.equal(verifyToken(token.slice(0, -4), SECRET), null);
+  assert.equal(verifyToken(`${token}AAAA`, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed body that is not JSON', () => {
+  const body = Buffer.from('not json').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
+
+for (const [name, token] of [
+  ['empty string', ''],
+  ['no dot', 'abc'],
+  ['three parts', 'a.b.c'],
+  ['empty parts', '.'],
+  ['non-string', 42],
+  ['null', null],
+  ['undefined', undefined],
+  ['object', {}],
+]) {
+  test(`verifyToken returns null and never throws for a malformed token (${name})`, () => {
+    assert.equal(verifyToken(token, SECRET), null);
+  });
+}
+
+test('verifyToken never throws for a bad secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), undefined), null);
+});
