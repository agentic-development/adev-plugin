+++ b/src/slug.mjs
@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return String(label)
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..0260ca9
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,137 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-123';
+const PAYLOAD = { sub: 'user-42', role: 'admin' };
+
+function expectedToken(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(body).digest('base64url');
+  return `${body}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('signToken matches a fixed known vector', () => {
+  assert.equal(
+    signToken({ a: 1 }, 'k'),
+    'eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g',
+  );
+});
+
+test('verifyToken returns the payload for a valid token', () => {
+  assert.deepEqual(verifyToken(expectedToken(PAYLOAD, SECRET), SECRET), { sub: 'user-42', role: 'admin' });
+});
+
+test('verifyToken round-trips a nested payload from signToken', () => {
+  const nested = { user: { id: 7, tags: ['a', 'b'], meta: { active: true, score: null } }, exp: 1700000000 };
+  assert.deepEqual(verifyToken(signToken(nested, SECRET), SECRET), {
+    user: { id: 7, tags: ['a', 'b'], meta: { active: true, score: null } },
+    exp: 1700000000,
+  });
+});
+
+test('verifyToken round-trips a non-ASCII payload', () => {
+  assert.deepEqual(verifyToken(signToken({ name: 'Zoë ✓' }, SECRET), SECRET), { name: 'Zoë ✓' });
+});
+
+test('verifyToken returns null for a token signed with a different secret', () => {
+  assert.equal(verifyToken(expectedToken(PAYLOAD, 'other-secret'), SECRET), null);
+});
+
+test('verifyToken returns null when the payload part is tampered', () => {
+  const [, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  const forgedBody = Buffer.from(JSON.stringify({ sub: 'user-42', role: 'superadmin' })).toString('base64url');
+  assert.equal(verifyToken(`${forgedBody}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature is tampered (same length)', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(flipped.length, sig.length);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated signature (length mismatch)', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -4)}`, SECRET), null);
+});
+
+test('verifyToken returns null for an over-long signature (length mismatch)', () => {
+  const token = expectedToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(`${token}AAAA`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty signature', () => {
+  const [body] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a token with no dot', () => {
+  const [body] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(body, SECRET), null);
+});
+
+test('verifyToken returns null for a token with an extra part', () => {
+  assert.equal(verifyToken(`${expectedToken(PAYLOAD, SECRET)}.extra`, SECRET), null);
+});
+
+test('verifyToken returns null for a token that is just a dot', () => {
+  assert.equal(verifyToken('.', SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed first part that is not valid JSON', () => {
+  const body = Buffer.from('not json{', 'utf8').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed first part that is not base64url', () => {
+  const body = '!!!@@@###';
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed empty first part', () => {
+  const sig = createHmac('sha256', SECRET).update('').digest('base64url');
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+});
+
+for (const [label, value] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 42],
+  ['an object', { token: 'x.y' }],
+  ['an array', ['a', 'b']],
+  ['a boolean', true],
+]) {
+  test(`verifyToken returns null for ${label} as the token`, () => {
+    assert.equal(verifyToken(value, SECRET), null);
+  });
+}
+
+for (const [label, value] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 42],
+  ['an object', { k: 1 }],
+]) {
+  test(`verifyToken returns null for ${label} as the secret`, () => {
+    assert.equal(verifyToken(expectedToken(PAYLOAD, SECRET), value), null);
+  });
+}
+
+test('verifyToken returns null for a validly signed first part with non-base64url characters that decode leniently', () => {
+  const body = 'eyJhIjoxfQ=!';
+  assert.deepEqual(JSON.parse(Buffer.from(body, 'base64url').toString('utf8')), { a: 1 });
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
