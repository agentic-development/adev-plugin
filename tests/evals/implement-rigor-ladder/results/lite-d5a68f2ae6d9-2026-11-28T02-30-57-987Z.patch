--- /dev/null
+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const ITEMS = [
+  { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+  { id: 'b2', label: 'Tea Pot!', priceCents: 2500 },
+  { id: 'c3', label: 'Spoon Set', priceCents: 799 },
+];
+
+test('listHandler returns the formatted items of the requested page', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, { items: ITEMS, currency: 'EUR' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'b2', label: 'Tea Pot!', slug: 'tea-pot', price: { cents: 2500, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  assert.deepEqual(listHandler({ page: 2, pageSize: 2 }, { items: ITEMS, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [{ id: 'c3', label: 'Spoon Set', slug: 'spoon-set', price: { cents: 799, currency: 'USD' } }],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler past the last page returns no items', () => {
+  assert.deepEqual(listHandler({ page: 5, pageSize: 2 }, { items: ITEMS, currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 5, pageCount: 2, total: 3 },
+  });
+});
+
+test('listHandler is registered under list', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("list", ...) reaches listHandler', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, { items: ITEMS, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [{ id: 'c3', label: 'Spoon Set', slug: 'spoon-set', price: { cents: 799, currency: 'USD' } }],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('dispatch of an unregistered name is still a 404', () => {
+  assert.deepEqual(dispatch('lists'), { status: 404 });
+});
