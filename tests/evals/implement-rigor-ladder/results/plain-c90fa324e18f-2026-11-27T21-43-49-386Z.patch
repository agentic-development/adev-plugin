diff --git a/tests/handlers/list.test.mjs b/tests/handlers/list.test.mjs
new file mode 100644
index 0000000..184dab3
--- /dev/null
+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const ITEMS = [
+  { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+  { id: 'a2', label: 'Red Mug', priceCents: 1399 },
+  { id: 'a3', label: 'Tea & Cake', priceCents: 500, stock: 9 },
+];
+const CTX = { items: ITEMS, currency: 'EUR' };
+
+test('listHandler returns the formatted items of the requested page', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, CTX), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'a2', label: 'Red Mug', slug: 'red-mug', price: { cents: 1399, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  assert.deepEqual(listHandler({ page: 2, pageSize: 2 }, CTX), {
+    status: 200,
+    body: {
+      items: [{ id: 'a3', label: 'Tea & Cake', slug: 'tea-cake', price: { cents: 500, currency: 'EUR' } }],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns no items for a page out of range', () => {
+  assert.deepEqual(listHandler({ page: 5, pageSize: 2 }, CTX), {
+    status: 200,
+    body: { items: [], page: 5, pageCount: 2, total: 3 },
+  });
+});
+
+test('listHandler of an empty catalog', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, { items: [], currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 1, pageCount: 0, total: 0 },
+  });
+});
+
+test('listHandler is registered under "list"', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("list", ...) reaches listHandler', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, CTX), listHandler({ page: 2, pageSize: 2 }, CTX));
+  assert.equal(dispatch('list', { page: 1, pageSize: 2 }, CTX).status, 200);
+});
+
+test('dispatch still returns 404 for an unregistered name', () => {
+  assert.deepEqual(dispatch('lists'), { status: 404 });
+});
