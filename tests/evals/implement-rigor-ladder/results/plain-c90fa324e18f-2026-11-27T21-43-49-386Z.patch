@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..56cc45d
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret';
+const PAYLOAD = { sub: 'user-1', role: 'admin', n: 42 };
+
+test('signToken produces base64url(JSON).base64url(HMAC-SHA256)', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  const body = Buffer.from(JSON.stringify(PAYLOAD)).toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(token, `${body}.${sig}`);
+});
+
+test('signToken output uses only base64url characters and one dot', () => {
+  const token = signToken({ s: '>>>???~~~' }, SECRET);
+  assert.match(token, /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
+});
+
+test('verifyToken round-trips the payload', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), PAYLOAD);
+});
+
+test('verifyToken returns null for the wrong secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), 'other-secret'), null);
+});
+
+test('verifyToken returns null for a tampered payload', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forged = Buffer.from(JSON.stringify({ ...PAYLOAD, role: 'root' })).toString('base64url');
+  assert.equal(verifyToken(`${forged}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated or extended signature', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(token.slice(0, -1), SECRET), null);
+  assert.equal(verifyToken(`${token}A`, SECRET), null);
+});
+
+test('verifyToken returns null for malformed tokens without throwing', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  for (const bad of ['', '.', 'abc', 'a.b.c', `${token}.extra`, '!!!.???', undefined, null, 42, {}, []]) {
+    assert.doesNotThrow(() => verifyToken(bad, SECRET));
+    assert.equal(verifyToken(bad, SECRET), null, `expected null for ${String(bad)}`);
+  }
+});
+
+test('verifyToken returns null for a correctly signed body that is not JSON', () => {
+  const body = Buffer.from('not json').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
+
+test('verifyToken never throws on a bad secret', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.doesNotThrow(() => verifyToken(token, undefined));
+  assert.equal(verifyToken(token, undefined), null);
+});
