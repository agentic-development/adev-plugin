diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..1bd9edc
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,118 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-6f1c2a';
+const PAYLOAD = { sub: 'user-42', role: 'admin', n: 7, tags: ['a', 'b'] };
+
+function hmac(part, secret) {
+  return createHmac('sha256', secret).update(part).digest('base64url');
+}
+
+function expectedToken(payload, secret) {
+  const first = Buffer.from(JSON.stringify(payload)).toString('base64url');
+  return `${first}.${hmac(first, secret)}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('signToken output has exactly one dot and no =, +, / characters', () => {
+  const payload = { s: '>>>???~~~', pad: 'ab' };
+  assert.match(Buffer.from(JSON.stringify(payload)).toString('base64'), /\+.*\/.*==$/);
+  const token = signToken(payload, SECRET);
+  assert.equal(token.split('.').length, 2);
+  assert.equal(/[=+/]/.test(token), false);
+});
+
+test('verifyToken returns a deep-equal payload for a token signed with the same secret', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), {
+    sub: 'user-42',
+    role: 'admin',
+    n: 7,
+    tags: ['a', 'b'],
+  });
+});
+
+test('verifyToken returns null when verified with a different secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), 'other-secret'), null);
+});
+
+test('verifyToken returns null when the payload part is tampered with', () => {
+  const [, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  const forgedBody = Buffer.from(JSON.stringify({ ...PAYLOAD, role: 'root' })).toString('base64url');
+  assert.equal(verifyToken(`${forgedBody}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature is tampered with (same length)', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated signature', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for an extended signature', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig}A`, SECRET), null);
+});
+
+test('verifyToken returns null for non-string tokens', () => {
+  assert.equal(verifyToken(undefined, SECRET), null);
+  assert.equal(verifyToken(null, SECRET), null);
+  assert.equal(verifyToken(42, SECRET), null);
+  assert.equal(verifyToken({ token: expectedToken(PAYLOAD, SECRET) }, SECRET), null);
+});
+
+test('verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a token with no dot', () => {
+  const [body] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(body, SECRET), null);
+});
+
+test('verifyToken returns null for a valid token with an extra dot-separated part', () => {
+  assert.equal(verifyToken(`${expectedToken(PAYLOAD, SECRET)}.extra`, SECRET), null);
+  assert.equal(verifyToken(`${expectedToken(PAYLOAD, SECRET)}.`, SECRET), null);
+});
+
+test('verifyToken returns null when either part is empty', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken('.', SECRET), null);
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part that is not valid JSON', () => {
+  const body = Buffer.from('{not json').toString('base64url');
+  assert.equal(verifyToken(`${body}.${hmac(body, SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed empty payload part', () => {
+  assert.equal(verifyToken(`.${hmac('', SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null for non-base64url garbage parts', () => {
+  assert.equal(verifyToken('!!!.@@@', SECRET), null);
+  assert.equal(verifyToken('%%%%.%%%%', SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part containing non-base64url characters', () => {
+  const body = `${Buffer.from(JSON.stringify(PAYLOAD)).toString('base64url')}!*`;
+  assert.equal(verifyToken(`${body}.${hmac(body, SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null when the secret is not a usable key', () => {
+  const token = expectedToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(token, undefined), null);
+  assert.equal(verifyToken(token, null), null);
+  assert.equal(verifyToken(token, 42), null);
+  assert.equal(verifyToken(token, {}), null);
+});
