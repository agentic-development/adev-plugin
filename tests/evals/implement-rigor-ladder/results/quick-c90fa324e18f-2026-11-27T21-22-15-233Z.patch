+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases the label', () => {
+  assert.equal(slugify('BlueMug'), 'bluemug');
+});
+
+test('slugify collapses each run of characters outside [a-z0-9] into a single -', () => {
+  assert.equal(slugify('blue  mug & co.2'), 'blue-mug-co-2');
+});
+
+test('slugify trims leading and trailing -', () => {
+  assert.equal(slugify('  --Blue Mug!-- '), 'blue-mug');
+});
