+});
+
+test('a percent coupon floors the discount rather than rounding it', () => {
+  // 999 * 33 / 100 = 329.67 -> floor 329 -> 670 (rounding would give 669)
+  assert.equal(applyDiscount(999, { kind: 'percent', amount: 33, expiresAt: 2_000 }, NOW), 670);
+});
+
