+
+test('a coupon with a missing kind throws COUPON_INVALID', () => {
+  assert.throws(
+    () => applyDiscount(2000, { amount: 500, expiresAt: 2_000 }, NOW),
+    { name: 'Error', code: 'COUPON_INVALID' },
+  );
+});
