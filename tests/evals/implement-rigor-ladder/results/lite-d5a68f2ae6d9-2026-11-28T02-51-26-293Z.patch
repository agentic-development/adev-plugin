@@ -0,0 +1,15 @@
+import { paginate } from '../pagination.mjs';
+import { formatItem } from '../format.mjs';
+
+export function listHandler({ page, pageSize }, { items, currency }) {
+  const result = paginate(items, { page, pageSize });
+  return {
+    status: 200,
+    body: {
+      items: result.items.map((item) => formatItem(item, currency)),
+      page: result.page,
+      pageCount: result.pageCount,
+      total: result.total,
+    },
+  };
+}
diff --git a/src/pagination.mjs b/src/pagination.mjs
index 60fe6c0..810af5e 100644
--- a/src/pagination.mjs
+++ b/src/pagination.mjs
@@ -1,3 +1,18 @@
 export function pageCount(total, pageSize) {
-  return Math.floor(total / pageSize) + 1;
+  if (total === 0) return 0;
+  return Math.ceil(total / pageSize);
+}
+
+export function paginate(items, { page, pageSize }) {
+  const total = items.length;
+  const pages = pageCount(total, pageSize);
+  const inRange = Number.isInteger(page) && page >= 1 && page <= pages;
+  const start = (page - 1) * pageSize;
+  return {
+    items: inRange ? items.slice(start, start + pageSize) : [],
+    page,
+    pageSize,
+    pageCount: pages,
+    total,
+  };
 }
