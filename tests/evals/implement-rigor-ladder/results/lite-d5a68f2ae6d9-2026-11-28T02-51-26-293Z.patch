+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..8b72342
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,144 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret';
+const PAYLOAD = { sub: 'user-1', role: 'admin', n: 42 };
+
+function expectedToken(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(body).digest('base64url');
+  return `${body}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('signToken matches an independently derived literal', () => {
+  assert.equal(
+    signToken({ a: 1 }, 'k'),
+    'eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g',
+  );
+});
+
+test('verifyToken returns the payload for a valid token', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), { sub: 'user-1', role: 'admin', n: 42 });
+});
+
+test('verifyToken returns the payload for an independently built token', () => {
+  assert.deepEqual(verifyToken('eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g', 'k'), { a: 1 });
+});
+
+test('unicode payload round-trips exactly', () => {
+  const payload = { name: 'Zoë 東京 🚀', tags: ['café', 'naïve'] };
+  const token = signToken(payload, SECRET);
+  assert.equal(token, expectedToken(payload, SECRET));
+  assert.deepEqual(verifyToken(token, SECRET), { name: 'Zoë 東京 🚀', tags: ['café', 'naïve'] });
+});
+
+for (const [label, input] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 42],
+  ['an object', { token: 'x' }],
+  ['an array', ['a', 'b']],
+  ['a boolean', true],
+]) {
+  test(`verifyToken returns null for ${label} instead of throwing`, () => {
+    assert.equal(verifyToken(input, SECRET), null);
+  });
+}
+
+test('verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a token with no separator', () => {
+  const [body] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(body, SECRET), null);
+});
+
+test('verifyToken returns null for a token with an extra segment', () => {
+  assert.equal(verifyToken(`${signToken(PAYLOAD, SECRET)}.extra`, SECRET), null);
+});
+
+test('verifyToken returns null for a token with a trailing empty segment', () => {
+  assert.equal(verifyToken(`${signToken(PAYLOAD, SECRET)}.`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty payload segment', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty payload segment even with its matching signature', () => {
+  const sig = createHmac('sha256', SECRET).update('').digest('base64url');
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty signature segment', () => {
+  const [body] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+});
+
+test('verifyToken returns null for a lone separator', () => {
+  assert.equal(verifyToken('.', SECRET), null);
+});
+
+test('verifyToken returns null for invalid JSON under a valid signature', () => {
+  const body = Buffer.from('{not json', 'utf8').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+  assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+});
+
+// Each body leniently decodes to '{}' in Buffer.from(..., 'base64url'), so only strict validation rejects it.
+for (const body of ['e30=', 'e3 0', 'e30*']) {
+  test(`verifyToken returns null for non-base64url payload segment ${JSON.stringify(body)} under a valid signature`, () => {
+    const sig = createHmac('sha256', SECRET).update(body).digest('base64url');
+    assert.equal(verifyToken(`${body}.${sig}`, SECRET), null);
+  });
+}
+
+test('verifyToken returns null for invalid base64url characters in the signature', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}+`, SECRET), null);
+});
+
+test('verifyToken returns null for the wrong secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), 'other-secret'), null);
+});
+
+test('verifyToken returns null for a tampered payload segment', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forged = Buffer.from(JSON.stringify({ ...PAYLOAD, role: 'root' }), 'utf8').toString('base64url');
+  assert.equal(verifyToken(`${forged}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature of the same length', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(flipped.length, sig.length);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature of a shorter length', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature of a longer length', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig}A`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature taken from a different token', () => {
+  const [body] = signToken(PAYLOAD, SECRET).split('.');
+  const [, otherSig] = signToken({ sub: 'user-2' }, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${otherSig}`, SECRET), null);
+});
+
+test('verifyToken returns null instead of throwing when the secret is missing', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), undefined), null);
+});
