--- /dev/null
+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,62 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const CATALOG = {
+  currency: 'EUR',
+  items: [
+    { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+    { id: 'b2', label: 'Tea Set!', priceCents: 4500 },
+    { id: 'c3', label: 'Coffee Beans 1kg', priceCents: 1800 },
+  ],
+};
+
+test('listHandler returns the formatted items of the requested page', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'b2', label: 'Tea Set!', slug: 'tea-set', price: { cents: 4500, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  assert.deepEqual(listHandler({ page: 2, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'c3', label: 'Coffee Beans 1kg', slug: 'coffee-beans-1kg', price: { cents: 1800, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler past the last page returns no items with status 200', () => {
+  assert.deepEqual(listHandler({ page: 5, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: { items: [], page: 5, pageCount: 2, total: 3 },
+  });
+});
+
+test('listHandler is registered under list', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("list", ...) reaches listHandler', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, CATALOG), listHandler({ page: 2, pageSize: 2 }, CATALOG));
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, CATALOG).body.items.map((i) => i.id), ['c3']);
+});
+
+test('dispatch of an unregistered name is still a 404', () => {
+  assert.deepEqual(dispatch('lists', { page: 1, pageSize: 2 }, CATALOG), { status: 404 });
+});
