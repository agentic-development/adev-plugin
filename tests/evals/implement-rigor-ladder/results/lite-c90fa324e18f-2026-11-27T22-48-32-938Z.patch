--- /dev/null
+++ b/src/slug.mjs
@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..7192221
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,141 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-1';
+const OTHER_SECRET = 'test-secret-2';
+const PAYLOAD = { sub: 'user-42', role: 'admin' };
+
+function expectedToken(payload, secret) {
+  const first = Buffer.from(JSON.stringify(payload)).toString('base64url');
+  const sig = createHmac('sha256', secret).update(first).digest('base64url');
+  return `${first}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('verifyToken returns a deep-equal payload for a token signed with the same secret', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), { sub: 'user-42', role: 'admin' });
+});
+
+test('verifyToken round-trips nested and unicode payloads', () => {
+  const payload = { name: 'Zoë 日本 🚀', tags: ['a', 'b'], meta: { depth: { level: 3 }, ok: true, none: null } };
+  assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), {
+    name: 'Zoë 日本 🚀',
+    tags: ['a', 'b'],
+    meta: { depth: { level: 3 }, ok: true, none: null },
+  });
+});
+
+test('verifyToken accepts a token built independently with node:crypto', () => {
+  assert.deepEqual(verifyToken(expectedToken({ id: 7 }, SECRET), SECRET), { id: 7 });
+});
+
+test('verifyToken returns null for a token signed with a different secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, OTHER_SECRET), SECRET), null);
+});
+
+test('verifyToken returns null when the payload part is tampered', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forged = Buffer.from(JSON.stringify({ sub: 'user-42', role: 'superadmin' })).toString('base64url');
+  assert.equal(verifyToken(`${forged}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature is replaced by a same-length wrong signature', () => {
+  const [first, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const wrong = createHmac('sha256', OTHER_SECRET).update(first).digest('base64url');
+  assert.equal(wrong.length, sig.length);
+  assert.notEqual(wrong, sig);
+  assert.equal(verifyToken(`${first}.${wrong}`, SECRET), null);
+});
+
+test('verifyToken returns null when one signature character is flipped', () => {
+  const [first, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(verifyToken(`${first}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a shorter signature', () => {
+  const [first, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${first}.${sig.slice(0, -1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a longer signature', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(`${token}A`, SECRET), null);
+});
+
+test('verifyToken returns null for a token without a dot', () => {
+  const [first] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(first, SECRET), null);
+});
+
+test('verifyToken returns null for a token with an extra dot-separated part', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(`${token}.extra`, SECRET), null);
+});
+
+test('verifyToken returns null for a token with a trailing dot', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(`${token}.`, SECRET), null);
+});
+
+test('verifyToken returns null for the empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a lone dot', () => {
+  assert.equal(verifyToken('.', SECRET), null);
+});
+
+test('verifyToken returns null for an empty payload part with a valid signature over it', () => {
+  const sig = createHmac('sha256', SECRET).update('').digest('base64url');
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty signature part', () => {
+  const [first] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${first}.`, SECRET), null);
+});
+
+test('verifyToken returns null for non-string tokens', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  const inputs = [undefined, null, 42, 0, true, {}, [], { token }, [token], Buffer.from(token)];
+  const results = inputs.map((input) => verifyToken(input, SECRET));
+  assert.deepEqual(results, inputs.map(() => null));
+});
+
+test('verifyToken returns null for a correctly signed first part that is not valid JSON', () => {
+  const first = Buffer.from('{not json').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(first).digest('base64url');
+  assert.equal(verifyToken(`${first}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed first part that is padded standard base64, not base64url', () => {
+  const first = Buffer.from(JSON.stringify({ a: 1 })).toString('base64');
+  assert.equal(first, 'eyJhIjoxfQ==');
+  const sig = createHmac('sha256', SECRET).update(first).digest('base64url');
+  assert.equal(verifyToken(`${first}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed first part containing non-base64url characters', () => {
+  const first = 'eyJhIjox+/fQ';
+  const sig = createHmac('sha256', SECRET).update(first).digest('base64url');
+  assert.equal(verifyToken(`${first}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature containing non-base64url characters', () => {
+  const [first, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const bad = `${sig.slice(0, -2)}+/`;
+  assert.equal(bad.length, sig.length);
+  assert.equal(verifyToken(`${first}.${bad}`, SECRET), null);
+});
+
+test('verifyToken returns null when the secret is not a usable HMAC key', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  const results = [undefined, null, 42, {}].map((secret) => verifyToken(token, secret));
+  assert.deepEqual(results, [null, null, null, null]);
+});
