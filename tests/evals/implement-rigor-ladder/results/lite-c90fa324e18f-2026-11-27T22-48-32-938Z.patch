+++ b/tests/slug.test.mjs
@@ -0,0 +1,27 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases and joins words with a dash', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify collapses a run of other characters into one dash', () => {
+  assert.equal(slugify('Tea  &  Coffee -- Set'), 'tea-coffee-set');
+});
+
+test('slugify trims leading and trailing dashes', () => {
+  assert.equal(slugify('  ¡Hello, World!  '), 'hello-world');
+});
+
+test('slugify keeps digits', () => {
+  assert.equal(slugify('Mug 2000 XL'), 'mug-2000-xl');
+});
+
+test('slugify replaces non-ASCII letters', () => {
+  assert.equal(slugify('Café Crème'), 'caf-cr-me');
+});
+
+test('slugify of a label with no slug characters is empty', () => {
+  assert.equal(slugify('!!!'), '');
+});
