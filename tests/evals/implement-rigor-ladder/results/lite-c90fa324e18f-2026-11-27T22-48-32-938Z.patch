+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const ITEMS = [
+  { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+  { id: 'a2', label: 'Red Plate', priceCents: 2450 },
+  { id: 'a3', label: 'Green Bowl', priceCents: 899 },
+];
+const CATALOG = { items: ITEMS, currency: 'EUR' };
+
+test('listHandler returns the formatted items of the requested page', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'a2', label: 'Red Plate', slug: 'red-plate', price: { cents: 2450, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  assert.deepEqual(listHandler({ page: 2, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a3', label: 'Green Bowl', slug: 'green-bowl', price: { cents: 899, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns no items for a page out of range', () => {
+  assert.deepEqual(listHandler({ page: 3, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: { items: [], page: 3, pageCount: 2, total: 3 },
+  });
+});
+
+test('listHandler of an empty catalog has zero pages', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, { items: [], currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 1, pageCount: 0, total: 0 },
+  });
+});
+
+test('listHandler is registered under list', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("list", ...) reaches listHandler', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a3', label: 'Green Bowl', slug: 'green-bowl', price: { cents: 899, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
