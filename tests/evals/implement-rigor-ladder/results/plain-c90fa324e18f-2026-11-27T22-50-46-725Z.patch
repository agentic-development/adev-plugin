@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..cb564f3
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 's3cret';
+const PAYLOAD = { sub: 'user-1', role: 'admin' };
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of the first part)', () => {
+  const head = Buffer.from(JSON.stringify(PAYLOAD)).toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(head).digest('base64url');
+  assert.equal(signToken(PAYLOAD, SECRET), `${head}.${sig}`);
+});
+
+test('signToken output matches a known vector', () => {
+  assert.equal(
+    signToken({ a: 1 }, 'k'),
+    'eyJhIjoxfQ.' + createHmac('sha256', 'k').update('eyJhIjoxfQ').digest('base64url'),
+  );
+});
+
+test('verifyToken round-trips the payload', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), PAYLOAD);
+});
+
+test('verifyToken returns null for the wrong secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, SECRET), 'other'), null);
+});
+
+test('verifyToken returns null for a tampered payload', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forged = Buffer.from(JSON.stringify({ ...PAYLOAD, role: 'root' })).toString('base64url');
+  assert.equal(verifyToken(`${forged}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature of the same length', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  const last = token.at(-1);
+  const flipped = token.slice(0, -1) + (last === 'A' ? 'B' : 'A');
+  assert.equal(verifyToken(flipped, SECRET), null);
+});
+
+test('verifyToken returns null for a signature of the wrong length', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(token.slice(0, -2), SECRET), null);
+  assert.equal(verifyToken(token + 'AA', SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed first part that is not JSON', () => {
+  const head = Buffer.from('not json').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(head).digest('base64url');
+  assert.equal(verifyToken(`${head}.${sig}`, SECRET), null);
+});
+
+test('verifyToken never throws on malformed tokens', () => {
+  for (const bad of ['', '.', 'abc', 'a.b.c', '..', '!!!.???', null, undefined, 42, {}, []]) {
+    assert.doesNotThrow(() => verifyToken(bad, SECRET));
+    assert.equal(verifyToken(bad, SECRET), null, String(bad));
+  }
+});
+
+test('verifyToken never throws on a bad secret', () => {
+  const token = signToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(token, undefined), null);
+});
