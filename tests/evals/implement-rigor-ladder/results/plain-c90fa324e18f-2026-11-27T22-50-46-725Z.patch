diff --git a/tests/handlers/list.test.mjs b/tests/handlers/list.test.mjs
new file mode 100644
index 0000000..d90c125
--- /dev/null
+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const CATALOG = {
+  currency: 'EUR',
+  items: [
+    { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+    { id: 'a2', label: 'Red Mug', priceCents: 1399 },
+    { id: 'a3', label: 'Tea & Pot', priceCents: 2500 },
+  ],
+};
+
+test('listHandler returns the formatted items of the requested page', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'a2', label: 'Red Mug', slug: 'red-mug', price: { cents: 1399, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  assert.deepEqual(listHandler({ page: 2, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: {
+      items: [{ id: 'a3', label: 'Tea & Pot', slug: 'tea-pot', price: { cents: 2500, currency: 'EUR' } }],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler of an out-of-range page is a 200 with no items', () => {
+  assert.deepEqual(listHandler({ page: 9, pageSize: 2 }, CATALOG), {
+    status: 200,
+    body: { items: [], page: 9, pageCount: 2, total: 3 },
+  });
+});
+
+test('listHandler of an empty catalog', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 2 }, { items: [], currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 1, pageCount: 0, total: 0 },
+  });
+});
+
+test('listHandler is registered under "list"', () => {
+  assert.equal(handlers.list, listHandler);
+});
+
+test('dispatch("list", ...) reaches listHandler', () => {
+  assert.deepEqual(
+    dispatch('list', { page: 2, pageSize: 2 }, CATALOG),
+    listHandler({ page: 2, pageSize: 2 }, CATALOG),
+  );
+  assert.equal(dispatch('list', { page: 1, pageSize: 2 }, CATALOG).body.items[0].slug, 'blue-mug');
+});
+
+test('dispatch of an unregistered name is still a 404', () => {
+  assert.deepEqual(dispatch('lists'), { status: 404 });
+});
