 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { pageCount } from '../src/pagination.mjs';
+import { pageCount, paginate } from '../src/pagination.mjs';
 
 test('pageCount rounds a partial page up', () => {
   assert.equal(pageCount(7, 5), 2);
 });
+
+test('pageCount of an exact multiple has no extra page', () => {
+  assert.equal(pageCount(10, 5), 2);
+});
+
+test('pageCount of zero items is 0', () => {
+  assert.equal(pageCount(0, 5), 0);
+});
+
+const ITEMS = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
+
+test('paginate returns the first page (1-based)', () => {
+  assert.deepEqual(paginate(ITEMS, { page: 1, pageSize: 3 }), {
+    items: ['a', 'b', 'c'],
+    page: 1,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns a partial last page', () => {
+  assert.deepEqual(paginate(ITEMS, { page: 3, pageSize: 3 }), {
+    items: ['g'],
+    page: 3,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate past the last page returns no items', () => {
+  assert.deepEqual(paginate(ITEMS, { page: 4, pageSize: 3 }), {
+    items: [],
+    page: 4,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate of page 0 or a negative page returns no items', () => {
+  assert.deepEqual(paginate(ITEMS, { page: 0, pageSize: 3 }).items, []);
+  assert.deepEqual(paginate(ITEMS, { page: -1, pageSize: 3 }).items, []);
+});
+
+test('paginate of an empty list returns no items and pageCount 0', () => {
+  assert.deepEqual(paginate([], { page: 1, pageSize: 3 }), {
+    items: [],
+    page: 1,
+    pageSize: 3,
+    pageCount: 0,
+    total: 0,
+  });
+});
+
+test('paginate of a non-integer page returns no items without throwing', () => {
+  assert.deepEqual(paginate(ITEMS, { page: 1.5, pageSize: 3 }).items, []);
+});
diff --git a/tests/slug.test.mjs b/tests/slug.test.mjs
new file mode 100644
index 0000000..893c59d
--- /dev/null
+++ b/tests/slug.test.mjs
@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases and joins words with -', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify collapses a run of non-alphanumerics into one -', () => {
+  assert.equal(slugify('Tea  &  Coffee!!Set'), 'tea-coffee-set');
+});
+
+test('slugify trims leading and trailing -', () => {
+  assert.equal(slugify('  --Hello, World!--  '), 'hello-world');
+});
+
+test('slugify keeps digits', () => {
+  assert.equal(slugify('Mug 2000 XL'), 'mug-2000-xl');
+});
+
+test('slugify replaces non-ASCII characters', () => {
+  assert.equal(slugify('Café Crème'), 'caf-cr-me');
+});
+
+test('slugify of only separators is empty', () => {
+  assert.equal(slugify('!!!'), '');
+  assert.equal(slugify(''), '');
+});
