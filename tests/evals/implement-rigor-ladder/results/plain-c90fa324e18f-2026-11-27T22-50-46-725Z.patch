index 0000000..977295b
--- /dev/null
+++ b/src/auth/token.mjs
@@ -0,0 +1,31 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+function sign(head, secret) {
+  return createHmac('sha256', secret).update(head).digest('base64url');
+}
+
+export function signToken(payload, secret) {
+  const head = Buffer.from(JSON.stringify(payload)).toString('base64url');
+  return `${head}.${sign(head, secret)}`;
+}
+
+export function verifyToken(token, secret) {
+  try {
+    if (typeof token !== 'string') return null;
+    const parts = token.split('.');
+    if (parts.length !== 2) return null;
+    const [head, sig] = parts;
+    if (!head || !sig) return null;
+
+    // Compare the canonical base64url signature strings, so non-canonical
+    // encodings of the same bytes are rejected.
+    const expected = Buffer.from(sign(head, secret));
+    const actual = Buffer.from(sig);
+    if (actual.length !== expected.length) return null;
+    if (!timingSafeEqual(actual, expected)) return null;
+
+    return JSON.parse(Buffer.from(head, 'base64url').toString('utf8'));
+  } catch {
+    return null;
+  }
+}
