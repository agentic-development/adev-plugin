+  { id: 'a4', label: 'Steel Spoon', priceCents: 150 },
+  { id: 'a5', label: 'Oak Tray', priceCents: 3100 },
+];
+
+test('listHandler returns 200 with the formatted items of the requested page', () => {
+  const res = listHandler({ page: 2, pageSize: 2 }, { items: catalog, currency: 'EUR' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a3', label: 'Green Bowl', slug: 'green-bowl', price: { cents: 899, currency: 'EUR' } },
+        { id: 'a4', label: 'Steel Spoon', slug: 'steel-spoon', price: { cents: 150, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('dispatch("list", ...) reaches the list handler', () => {
+  const res = dispatch('list', { page: 3, pageSize: 2 }, { items: catalog, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a5', label: 'Oak Tray', slug: 'oak-tray', price: { cents: 3100, currency: 'USD' } },
+      ],
+      page: 3,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('listHandler returns 200 with no items for a page past pageCount', () => {
+  const res = listHandler({ page: 4, pageSize: 2 }, { items: catalog, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: { items: [], page: 4, pageCount: 3, total: 5 },
+  });
+});
+
+test('listHandler on an empty catalog returns pageCount 0 and total 0', () => {
+  const res = listHandler({ page: 1, pageSize: 2 }, { items: [], currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: { items: [], page: 1, pageCount: 0, total: 0 },
+  });
+});
