+test('pageCount returns 0 when total is 0', () => {
+  assert.equal(pageCount(0, 5), 0);
+});
+
+const seeded = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
+
+test('paginate returns the first page with metadata', () => {
+  assert.deepEqual(paginate(seeded, { page: 1, pageSize: 3 }), {
