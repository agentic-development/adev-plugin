+++ b/tests/slug.test.mjs
@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases the label', () => {
+  assert.equal(slugify('Widget'), 'widget');
+});
+
+test('slugify replaces each run of characters outside [a-z0-9] with a single dash', () => {
+  assert.equal(slugify('blue  widget 3000 & co!!x'), 'blue-widget-3000-co-x');
+});
+
+test('slugify trims leading and trailing dashes', () => {
+  assert.equal(slugify('  --Hello, World!--  '), 'hello-world');
+});
