new file mode 100644
index 0000000..341228d
--- /dev/null
+++ b/src/auth/token.mjs
@@ -0,0 +1,49 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+// Unpadded base64url, at least one character.
+const BASE64URL = /^[A-Za-z0-9_-]+$/;
+
+function sign(body, secret) {
+  return createHmac('sha256', secret).update(body).digest('base64url');
+}
+
+/**
+ * BEH-6: returns `<base64url(JSON payload)>.<base64url(HMAC-SHA256 of the first part)>`.
+ * The HMAC is computed over the base64url text of the first part.
+ * @throws {TypeError} If `payload` cannot be encoded by JSON.stringify, or `secret` is not a valid HMAC key.
+ */
+export function signToken(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  return `${body}.${sign(body, secret)}`;
+}
+
+/**
+ * BEH-6: returns the payload when the signature matches (constant-time compare),
+ * and null for a bad signature or a malformed token. Never throws.
+ */
+export function verifyToken(token, secret) {
+  if (typeof token !== 'string') return null;
+  const parts = token.split('.');
+  if (parts.length !== 2) return null;
+  const [body, sig] = parts;
+  if (!BASE64URL.test(body) || !BASE64URL.test(sig)) return null;
+
+  // Compare the canonical encoded signature, so non-canonical encodings of the
+  // same digest bytes are rejected; lengths are checked first because
+  // timingSafeEqual throws on unequal-length buffers.
+  let expectedSig;
+  try {
+    expectedSig = sign(body, secret);
+  } catch {
+    return null; // secret rejected by node:crypto
+  }
+  const expected = Buffer.from(expectedSig, 'utf8');
+  const actual = Buffer.from(sig, 'utf8');
+  if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) return null;
+
+  try {
+    return JSON.parse(Buffer.from(body, 'base64url').toString('utf8'));
+  } catch {
+    return null;
+  }
+}
