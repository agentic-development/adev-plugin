+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..fcd2f08
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,193 @@
+import { test, mock } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto, { createHmac } from 'node:crypto';
+import { syncBuiltinESMExports } from 'node:module';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-key';
+const OTHER_SECRET = 'other-secret-key';
+const PAYLOAD = { sub: 'user-42', role: 'admin' };
+
+// Builds the expected token directly with node:crypto, following the BEH-6 recipe.
+// It mirrors the algorithm, so the hardcoded literal vectors below pin the exact output.
+function expectedToken(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(body).digest('base64url');
+  return `${body}.${sig}`;
+}
+
+test('BEH-6: signToken returns base64url(JSON).base64url(HMAC-SHA256 over first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('BEH-6: signToken matches a precomputed literal token', () => {
+  assert.equal(
+    signToken(PAYLOAD, SECRET),
+    'eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFkbWluIn0.iP7jEOd-LwMypGHRmVsLmQJA0_2Siguy-pqIoCjZ8_I',
+  );
+});
+
+test('BEH-6: verifyToken returns the exact payload for a validly signed token', () => {
+  const token = expectedToken(PAYLOAD, SECRET);
+  assert.deepEqual(verifyToken(token, SECRET), { sub: 'user-42', role: 'admin' });
+});
+
+test('BEH-6: verifyToken returns null for a token signed with a different secret', () => {
+  const token = expectedToken(PAYLOAD, OTHER_SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a tampered payload part with the original signature', () => {
+  const [, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  const forgedBody = Buffer.from(JSON.stringify({ sub: 'user-42', role: 'root' }), 'utf8').toString('base64url');
+  assert.equal(verifyToken(`${forgedBody}.${sig}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a tampered signature of the same length', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  // Flip the first signature character to a different base64url character.
+  const tamperedSig = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(tamperedSig.length, sig.length);
+  assert.notEqual(tamperedSig, sig);
+  assert.equal(verifyToken(`${body}.${tamperedSig}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a truncated signature', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -4)}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for an over-long signature', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig}AAAA`, SECRET), null);
+});
+
+// Signs an arbitrary first-part string with a correct HMAC, independently of the module.
+function signRawBody(body, secret) {
+  return `${body}.${createHmac('sha256', secret).update(body).digest('base64url')}`;
+}
+
+test('BEH-6: verifyToken returns null for non-string token inputs', () => {
+  assert.equal(verifyToken(null, SECRET), null);
+  assert.equal(verifyToken(undefined, SECRET), null);
+  assert.equal(verifyToken(42, SECRET), null);
+  assert.equal(verifyToken({ token: 'a.b' }, SECRET), null);
+  assert.equal(verifyToken(['a', 'b'], SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a token with no dot', () => {
+  const [body] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(body, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a token with more than one dot', () => {
+  const token = expectedToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(`${token}.extra`, SECRET), null);
+  const [body, sig] = token.split('.');
+  assert.equal(verifyToken(`${body}..${sig}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for empty parts', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken('.', SECRET), null);
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+  // An empty first part with a correctly computed HMAC over the empty string.
+  assert.equal(verifyToken(signRawBody('', SECRET), SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null when the payload part is not base64url, even with a correct HMAC over it', () => {
+  const [body] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(signRawBody(`${body}!`, SECRET), SECRET), null);
+  assert.equal(verifyToken(signRawBody(`${body}=`, SECRET), SECRET), null);
+  assert.equal(verifyToken(signRawBody(body.replace(/-|_/g, '+') + '+/', SECRET), SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null when the signature part is not base64url', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig}=`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig}!`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig.slice(0, 20)}*${sig.slice(20)}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a non-canonical signature encoding of the same bytes', () => {
+  const [body, sig] = expectedToken(PAYLOAD, SECRET).split('.');
+  // 43 chars carry 258 bits for a 256-bit digest; the last char's low 2 bits are slack.
+  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';
+  const last = alphabet.indexOf(sig[sig.length - 1]);
+  const variant = sig.slice(0, -1) + alphabet[last ^ 1];
+  assert.deepEqual(Buffer.from(variant, 'base64url'), Buffer.from(sig, 'base64url'));
+  assert.equal(verifyToken(`${body}.${variant}`, SECRET), null);
+});
+
+test('BEH-6: verifyToken returns null for a validly signed payload part that is not valid JSON', () => {
+  const body = Buffer.from('{"sub":"user-42",', 'utf8').toString('base64url');
+  assert.equal(verifyToken(signRawBody(body, SECRET), SECRET), null);
+});
+
+test('BEH-6: signToken/verifyToken round-trip a nested payload with unicode', () => {
+  const payload = {
+    user: { id: 7, name: 'Zoë Ångström', tags: ['café', '日本語', '🚀'] },
+    scopes: ['read', 'write'],
+    meta: { nested: { deep: true, n: null } },
+  };
+  const token = signToken(payload, SECRET);
+  assert.equal(token, expectedToken(payload, SECRET));
+  assert.deepEqual(verifyToken(token, SECRET), {
+    user: { id: 7, name: 'Zoë Ångström', tags: ['café', '日本語', '🚀'] },
+    scopes: ['read', 'write'],
+    meta: { nested: { deep: true, n: null } },
+  });
+});
+
+test('BEH-6: verifyToken returns null (never throws) for an invalid secret', () => {
+  const validToken = expectedToken(PAYLOAD, SECRET);
+  assert.equal(verifyToken(validToken, undefined), null);
+  assert.equal(verifyToken(validToken, null), null);
+  assert.equal(verifyToken(validToken, 42), null);
+  assert.equal(verifyToken(validToken, {}), null);
+  assert.equal(verifyToken(validToken), null);
+});
+
+test('BEH-6: signToken matches a precomputed literal token for a nested unicode payload', () => {
+  const payload = {
+    user: { id: 7, name: 'Zoë Ångström', tags: ['café', '日本語', '🚀'] },
+    scopes: ['read', 'write'],
+    meta: { nested: { deep: true, n: null } },
+  };
+  assert.equal(
+    signToken(payload, SECRET),
+    'eyJ1c2VyIjp7ImlkIjo3LCJuYW1lIjoiWm_DqyDDhW5nc3Ryw7ZtIiwidGFncyI6WyJjYWbDqSIsIuaXpeacrOiqniIsIvCfmoAiXX0sInNjb3BlcyI6WyJyZWFkIiwid3JpdGUiXSwibWV0YSI6eyJuZXN0ZWQiOnsiZGVlcCI6dHJ1ZSwibiI6bnVsbH19fQ.VSbQBnvlIawU5Rc9V--xDL7LvN6M4ht-hAcZ1M12B4Q',
+  );
+});
+
+test('BEH-6: verifyToken decides the signature match with crypto.timingSafeEqual', async (t) => {
+  // Spy at the external boundary (node:crypto); a fresh module instance binds the spied export.
+  const spy = mock.method(crypto, 'timingSafeEqual');
+  syncBuiltinESMExports();
+  t.after(() => {
+    spy.mock.restore();
+    syncBuiltinESMExports();
+  });
+  const fresh = await import('../../src/auth/token.mjs?timing-spy');
+  const validToken = expectedToken(PAYLOAD, SECRET);
+
+  // (1) A valid token verifies to its exact payload via exactly one timingSafeEqual call.
+  assert.deepEqual(fresh.verifyToken(validToken, SECRET), { sub: 'user-42', role: 'admin' });
+  assert.equal(spy.mock.callCount(), 1);
+
+  // (2) A same-length tampered signature returns null, and is also compared via timingSafeEqual.
+  const [body, sig] = validToken.split('.');
+  const tamperedSig = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(fresh.verifyToken(`${body}.${tamperedSig}`, SECRET), null);
+  assert.equal(spy.mock.callCount(), 2);
+
+  // (3) timingSafeEqual's verdict decides the result: forcing false rejects a valid token.
+  spy.mock.mockImplementation(() => false);
+  assert.equal(fresh.verifyToken(validToken, SECRET), null);
+  assert.equal(spy.mock.callCount(), 3);
+});
