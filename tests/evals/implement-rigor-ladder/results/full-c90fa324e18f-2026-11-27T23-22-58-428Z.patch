+    items: [],
+    page: -1,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns items: [] for a page past pageCount', () => {
+  assert.deepEqual(paginate(seeded, { page: 4, pageSize: 3 }), {
+    items: [],
+    page: 4,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate on an empty list returns pageCount 0 and items: [] for page 1', () => {
+  assert.deepEqual(paginate([], { page: 1, pageSize: 3 }), {
+    items: [],
+    page: 1,
+    pageSize: 3,
+    pageCount: 0,
+    total: 0,
+  });
