new file mode 100644
index 0000000..ed69fbf
--- /dev/null
+++ b/src/auth/token.mjs
@@ -0,0 +1,30 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+const TOKEN_PATTERN = /^([A-Za-z0-9_-]+)\.([A-Za-z0-9_-]+)$/;
+
+function sign(data, secret) {
+  return createHmac('sha256', secret).update(data).digest('base64url');
+}
+
+export function signToken(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  return `${body}.${sign(body, secret)}`;
+}
+
+// Returns the payload when the signature matches, otherwise null. Never throws.
+export function verifyToken(token, secret) {
+  if (typeof token !== 'string') return null;
+  const match = TOKEN_PATTERN.exec(token);
+  if (match === null) return null;
+  const [, body, signature] = match;
+  try {
+    const actual = Buffer.from(signature, 'utf8');
+    const expected = Buffer.from(sign(body, secret), 'utf8');
+    // timingSafeEqual throws on length mismatch, so guard lengths first.
+    if (actual.length !== expected.length || !timingSafeEqual(actual, expected)) return null;
+    // Parse only after the signature has been verified.
+    return JSON.parse(Buffer.from(body, 'base64url').toString('utf8'));
+  } catch {
+    return null;
+  }
+}
