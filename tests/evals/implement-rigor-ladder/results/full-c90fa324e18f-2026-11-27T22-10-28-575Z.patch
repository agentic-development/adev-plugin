+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases the label', () => {
+  assert.equal(slugify('Widget'), 'widget');
+});
+
+test('slugify replaces every run of characters outside [a-z0-9] with a single -', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+  assert.equal(slugify('Mug  & -- Saucer'), 'mug-saucer');
+  assert.equal(slugify('Size 42 Boots'), 'size-42-boots');
+  assert.equal(slugify('Café Noir'), 'caf-noir');
+});
+
+test('slugify trims leading and trailing -', () => {
+  assert.equal(slugify('  Blue Mug!  '), 'blue-mug');
+  assert.equal(slugify('--Café--'), 'caf');
+  assert.equal(slugify('***'), '');
+});
