+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch } from '../../src/registry.mjs';
+
+const items = [
+  { id: 'a1', label: 'Blue Mug', priceCents: 1299, stock: 4 },
+  { id: 'a2', label: 'Red Plate', priceCents: 850, stock: 0 },
+  { id: 'a3', label: 'Tea Pot', priceCents: 3400, stock: 2 },
+];
+
+test('listHandler returns status 200 with the formatted items of the requested page', () => {
+  const res = listHandler({ page: 1, pageSize: 2 }, { items, currency: 'EUR' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'a2', label: 'Red Plate', slug: 'red-plate', price: { cents: 850, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns the last, partial page', () => {
+  const res = listHandler({ page: 2, pageSize: 2 }, { items, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a3', label: 'Tea Pot', slug: 'tea-pot', price: { cents: 3400, currency: 'USD' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('listHandler returns status 200 and no items for a page beyond the last', () => {
+  const res = listHandler({ page: 3, pageSize: 2 }, { items, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: { items: [], page: 3, pageCount: 2, total: 3 },
+  });
+});
+
+test('dispatch("list", ...) reaches listHandler through the registry', () => {
+  const res = dispatch('list', { page: 1, pageSize: 1 }, { items, currency: 'GBP' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'GBP' } },
+      ],
+      page: 1,
+      pageCount: 3,
+      total: 3,
+    },
+  });
+});
