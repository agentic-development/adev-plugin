+  assert.throws(
+    () => parseConfig(text),
+    (err) => {
+      assert.ok(err instanceof Error, `expected Error instance for ${text}`);
+      assert.equal(err.code, 'CONFIG_INVALID', `expected CONFIG_INVALID for ${text}`);
+      return true;
+    },
+  );
+}
+
+test('parseConfig rejects null with CONFIG_INVALID', () => {
+  assertConfigInvalid('null');
+});
+
+test('parseConfig rejects arrays with CONFIG_INVALID', () => {
+  assertConfigInvalid('[]');
+  assertConfigInvalid('[{"pageSize":10}]');
+});
+
+test('parseConfig rejects a pageSize that is not a positive integer', () => {
+  assertConfigInvalid('{"pageSize":0}');
+  assertConfigInvalid('{"pageSize":-5}');
+  assertConfigInvalid('{"pageSize":2.5}');
+  assertConfigInvalid('{"pageSize":"10"}');
+  assertConfigInvalid('{"pageSize":null}');
+  assertConfigInvalid('{"pageSize":true}');
+  assertConfigInvalid('{"pageSize":[10]}');
+});
+
+test('parseConfig rejects non-object JSON primitives with CONFIG_INVALID', () => {
+  assertConfigInvalid('42');
+  assertConfigInvalid('"text"');
+  assertConfigInvalid('true');
+  assertConfigInvalid('false');
+});
+
+test('parseConfig returns explicit valid values as given', () => {
+  assert.deepEqual(parseConfig('{"pageSize":50,"currency":"EUR"}'), { pageSize: 50, currency: 'EUR' });
+  assert.deepEqual(parseConfig('{"pageSize":1}'), { pageSize: 1, currency: 'USD' });
+});
