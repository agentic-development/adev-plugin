@@ -1,7 +1,77 @@
 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { pageCount } from '../src/pagination.mjs';
+import { pageCount, paginate } from '../src/pagination.mjs';
 
 test('pageCount rounds a partial page up', () => {
   assert.equal(pageCount(7, 5), 2);
 });
+
+test('pageCount returns an exact page count when total divides evenly', () => {
+  assert.equal(pageCount(10, 5), 2);
+});
+
+test('pageCount returns 0 when total is 0', () => {
+  assert.equal(pageCount(0, 5), 0);
+});
+
+const seven = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
+
+test('paginate returns the first page with metadata', () => {
+  assert.deepEqual(paginate(seven, { page: 1, pageSize: 3 }), {
+    items: ['a', 'b', 'c'],
+    page: 1,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns a partial last page', () => {
+  assert.deepEqual(paginate(seven, { page: 3, pageSize: 3 }), {
+    items: ['g'],
+    page: 3,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns no items for page 0', () => {
+  assert.deepEqual(paginate(seven, { page: 0, pageSize: 3 }), {
+    items: [],
+    page: 0,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns no items for a negative page', () => {
+  assert.deepEqual(paginate(seven, { page: -1, pageSize: 3 }), {
+    items: [],
+    page: -1,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns no items for a page beyond the last page', () => {
+  assert.deepEqual(paginate(seven, { page: 4, pageSize: 3 }), {
+    items: [],
+    page: 4,
+    pageSize: 3,
+    pageCount: 3,
+    total: 7,
+  });
+});
+
+test('paginate returns no items and pageCount 0 for an empty list', () => {
+  assert.deepEqual(paginate([], { page: 1, pageSize: 3 }), {
+    items: [],
+    page: 1,
+    pageSize: 3,
+    pageCount: 0,
+    total: 0,
+  });
+});
