diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..4708bc4
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,172 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto, { createHmac } from 'node:crypto';
+import { syncBuiltinESMExports } from 'node:module';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 's3cret';
+const PAYLOAD = { sub: 'alice', n: 1 };
+// Known-answer vector computed independently with openssl:
+//   base64url('{"sub":"alice","n":1}') + '.' + base64url(HMAC-SHA256(key='s3cret', first part))
+const KNOWN_TOKEN = 'eyJzdWIiOiJhbGljZSIsIm4iOjF9.IqbkboHP7xTHcjBQHPhrWivgffPF9nuovK5DCjOySMg';
+
+function hmacB64url(data, secret) {
+  return createHmac('sha256', secret).update(data).digest('base64url');
+}
+
+function b64urlJson(value) {
+  return Buffer.from(JSON.stringify(value), 'utf8').toString('base64url');
+}
+
+test('signToken matches a hardcoded known-answer vector', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), KNOWN_TOKEN);
+});
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  const payload = { user: 'bob', roles: ['admin', 'ops'], exp: 1_700_000_000 };
+  const secret = 'another-secret';
+  const first = b64urlJson(payload);
+  const expected = `${first}.${hmacB64url(first, secret)}`;
+  assert.equal(signToken(payload, secret), expected);
+});
+
+test('verifyToken returns the payload of the known-answer token', () => {
+  assert.deepEqual(verifyToken(KNOWN_TOKEN, SECRET), { sub: 'alice', n: 1 });
+});
+
+test('verifyToken round-trips nested objects, arrays and unicode strings', () => {
+  const payload = {
+    user: { id: 42, name: 'Zoë 日本語 🚀', tags: ['a', 'b'] },
+    flags: { active: true, deleted: false, note: null },
+    scores: [1, 2.5, -3],
+  };
+  assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), {
+    user: { id: 42, name: 'Zoë 日本語 🚀', tags: ['a', 'b'] },
+    flags: { active: true, deleted: false, note: null },
+    scores: [1, 2.5, -3],
+  });
+});
+
+test('verifyToken round-trips non-object JSON payloads', () => {
+  assert.equal(verifyToken(signToken('héllo', SECRET), SECRET), 'héllo');
+  assert.equal(verifyToken(signToken(7, SECRET), SECRET), 7);
+  assert.deepEqual(verifyToken(signToken([1, 'two'], SECRET), SECRET), [1, 'two']);
+});
+
+test('verifyToken returns null for a token signed with a different secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, 'other-secret'), SECRET), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, 's3cret '), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, ''), null);
+});
+
+test('verifyToken returns null for a tampered payload carrying the original signature', () => {
+  const [, signature] = KNOWN_TOKEN.split('.');
+  const forgedBody = b64urlJson({ sub: 'mallory', n: 1 });
+  assert.equal(verifyToken(`${forgedBody}.${signature}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature of the same length', () => {
+  const [body, signature] = KNOWN_TOKEN.split('.');
+  const flipped = (signature[0] === 'A' ? 'B' : 'A') + signature.slice(1);
+  assert.equal(flipped.length, signature.length);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null (never throws) for truncated or extended signatures', () => {
+  const [body, signature] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken(`${body}.${signature.slice(0, -1)}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${signature.slice(0, 10)}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${signature}A`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${signature}${signature}`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature is the raw bytes in another encoding', () => {
+  const [body] = KNOWN_TOKEN.split('.');
+  const hexSig = createHmac('sha256', SECRET).update(body).digest('hex');
+  const b64Sig = createHmac('sha256', SECRET).update(body).digest('base64');
+  assert.equal(verifyToken(`${body}.${hexSig}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${b64Sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for non-string tokens', () => {
+  assert.equal(verifyToken(undefined, SECRET), null);
+  assert.equal(verifyToken(null, SECRET), null);
+  assert.equal(verifyToken(123, SECRET), null);
+  assert.equal(verifyToken({ token: KNOWN_TOKEN }, SECRET), null);
+  assert.equal(verifyToken([KNOWN_TOKEN], SECRET), null);
+  assert.equal(verifyToken(Buffer.from(KNOWN_TOKEN), SECRET), null);
+});
+
+test('verifyToken returns null for an empty string or a token without a dot', () => {
+  const [body, signature] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken('', SECRET), null);
+  assert.equal(verifyToken(`${body}${signature}`, SECRET), null);
+  assert.equal(verifyToken(body, SECRET), null);
+});
+
+test('verifyToken returns null for a token with more than one dot', () => {
+  assert.equal(verifyToken(`${KNOWN_TOKEN}.`, SECRET), null);
+  assert.equal(verifyToken(`${KNOWN_TOKEN}.extra`, SECRET), null);
+  assert.equal(verifyToken(`.${KNOWN_TOKEN}`, SECRET), null);
+  assert.equal(verifyToken('a.b.c', SECRET), null);
+});
+
+test('verifyToken returns null when either part is empty', () => {
+  const [body, signature] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken('.', SECRET), null);
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+  assert.equal(verifyToken(`.${signature}`, SECRET), null);
+  assert.equal(verifyToken(`.${hmacB64url('', SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed first part with invalid base64url characters', () => {
+  const valid = b64urlJson({ a: 1 });
+  for (const body of [`${valid}=`, `${valid}+`, `${valid}/`, `ey J9`, `ey!J9`, `${valid}\n`]) {
+    assert.equal(verifyToken(`${body}.${hmacB64url(body, SECRET)}`, SECRET), null, `body ${JSON.stringify(body)}`);
+  }
+});
+
+test('verifyToken returns null (never throws) for a correctly signed payload that is not valid JSON', () => {
+  for (const text of ['not json', '{"a":1', '\u0000', '�']) {
+    const body = Buffer.from(text, 'utf8').toString('base64url');
+    assert.equal(verifyToken(`${body}.${hmacB64url(body, SECRET)}`, SECRET), null, `text ${JSON.stringify(text)}`);
+  }
+  const invalidUtf8 = Buffer.from([0xff, 0xfe, 0x7b]).toString('base64url');
+  assert.equal(verifyToken(`${invalidUtf8}.${hmacB64url(invalidUtf8, SECRET)}`, SECRET), null);
+});
+
+test('verifyToken returns null (never throws) for a missing or non-string secret', () => {
+  assert.equal(verifyToken(KNOWN_TOKEN, undefined), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, null), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, 123), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, {}), null);
+});
+
+test('verifyToken compares signatures with crypto.timingSafeEqual', (t) => {
+  t.after(() => {
+    t.mock.restoreAll();
+    syncBuiltinESMExports();
+  });
+  const spy = t.mock.method(crypto, 'timingSafeEqual');
+  syncBuiltinESMExports();
+
+  const [body, signature] = KNOWN_TOKEN.split('.');
+  const tampered = `${body}.${(signature[0] === 'A' ? 'B' : 'A') + signature.slice(1)}`;
+
+  assert.deepEqual(verifyToken(KNOWN_TOKEN, SECRET), { sub: 'alice', n: 1 });
+  assert.equal(verifyToken(tampered, SECRET), null);
+  assert.equal(spy.mock.callCount(), 2);
+});
+
+test('verifyToken does not parse the payload when the signature does not match', (t) => {
+  const spy = t.mock.method(JSON, 'parse');
+  const [, signature] = KNOWN_TOKEN.split('.');
+  const forged = `${b64urlJson({ sub: 'mallory', n: 1 })}.${signature}`;
+
+  assert.equal(verifyToken(forged, SECRET), null);
+  assert.equal(verifyToken(signToken(PAYLOAD, 'other-secret'), SECRET), null);
+  assert.equal(spy.mock.callCount(), 0);
+
+  assert.deepEqual(verifyToken(KNOWN_TOKEN, SECRET), { sub: 'alice', n: 1 });
+  assert.equal(spy.mock.callCount(), 1);
+});
