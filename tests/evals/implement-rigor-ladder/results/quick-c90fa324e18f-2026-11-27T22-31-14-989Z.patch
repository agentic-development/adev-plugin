@@ -11,3 +11,70 @@ test('a fixed coupon subtracts its amount', () => {
 test('an expired coupon leaves the price unchanged', () => {
   assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: 500 }, NOW), 2000);
 });
+
+// --- BEH-4: percent coupons, floor at 0, COUPON_INVALID ---
+
+const FUTURE = 2_000;
+
+function assertCouponInvalid(err) {
+  assert.ok(err instanceof Error, 'expected an Error instance');
+  assert.equal(err.code, 'COUPON_INVALID');
+  return true;
+}
+
+test('a percent coupon subtracts that percentage of the price', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: FUTURE }, NOW), 1500);
+});
+
+test('a percent coupon floors the discount amount (999 x 15% subtracts 149)', () => {
+  assert.equal(applyDiscount(999, { kind: 'percent', amount: 15, expiresAt: FUTURE }, NOW), 850);
+});
+
+test('a percent coupon expiring exactly at now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: NOW }, NOW), 2000);
+});
+
+test('a fixed coupon expiring exactly at now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: NOW }, NOW), 2000);
+});
+
+test('an expired percent coupon leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 500 }, NOW), 2000);
+});
+
+test('a fixed coupon larger than the price yields 0', () => {
+  assert.equal(applyDiscount(300, { kind: 'fixed', amount: 500, expiresAt: FUTURE }, NOW), 0);
+});
+
+test('a fixed coupon equal to the price yields 0', () => {
+  assert.equal(applyDiscount(500, { kind: 'fixed', amount: 500, expiresAt: FUTURE }, NOW), 0);
+});
+
+test('a 100% percent coupon yields 0', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 100, expiresAt: FUTURE }, NOW), 0);
+});
+
+test('a percent coupon over 100% yields 0', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 150, expiresAt: FUTURE }, NOW), 0);
+});
+
+test('an unknown coupon kind throws an Error with code COUPON_INVALID', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: 'bogus', amount: 500, expiresAt: FUTURE }, NOW),
+    assertCouponInvalid,
+  );
+});
+
+test('an undefined coupon kind throws an Error with code COUPON_INVALID', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: undefined, amount: 500, expiresAt: FUTURE }, NOW),
+    assertCouponInvalid,
+  );
+});
+
+test('an unknown coupon kind throws COUPON_INVALID even when the coupon is expired', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: 'bogus', amount: 500, expiresAt: 500 }, NOW),
+    assertCouponInvalid,
+  );
+});
