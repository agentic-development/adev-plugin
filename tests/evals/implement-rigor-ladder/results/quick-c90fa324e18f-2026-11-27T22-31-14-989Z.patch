+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,75 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listHandler } from '../../src/handlers/list.mjs';
+import { dispatch, handlers } from '../../src/registry.mjs';
+
+const items = [
+  { id: 'a1', label: 'Blue Mug', priceCents: 1299 },
+  { id: 'a2', label: 'Red Tea Pot', priceCents: 4500 },
+  { id: 'a3', label: 'Green Cup', priceCents: 850 },
+  { id: 'a4', label: 'Steel Spoon', priceCents: 199 },
+  { id: 'a5', label: 'Oak Tray', priceCents: 3200 },
+];
+
+test('listHandler returns the formatted first page', () => {
+  const res = listHandler({ page: 1, pageSize: 2 }, { items, currency: 'EUR' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a1', label: 'Blue Mug', slug: 'blue-mug', price: { cents: 1299, currency: 'EUR' } },
+        { id: 'a2', label: 'Red Tea Pot', slug: 'red-tea-pot', price: { cents: 4500, currency: 'EUR' } },
+      ],
+      page: 1,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('listHandler returns a partial last page', () => {
+  const res = listHandler({ page: 3, pageSize: 2 }, { items, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a5', label: 'Oak Tray', slug: 'oak-tray', price: { cents: 3200, currency: 'USD' } },
+      ],
+      page: 3,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+});
+
+test('listHandler returns no items for an out-of-range page', () => {
+  const res = listHandler({ page: 4, pageSize: 2 }, { items, currency: 'USD' });
+  assert.deepEqual(res, {
+    status: 200,
+    body: { items: [], page: 4, pageCount: 3, total: 5 },
+  });
+});
+
+test('listHandler body has exactly the keys items, page, pageCount and total', () => {
+  const res = listHandler({ page: 2, pageSize: 2 }, { items, currency: 'GBP' });
+  assert.deepEqual(Object.keys(res.body), ['items', 'page', 'pageCount', 'total']);
+});
+
+test('dispatch("list", ...) reaches the registered list handler', () => {
+  const query = { page: 2, pageSize: 2 };
+  const ctx = { items, currency: 'EUR' };
+  assert.deepEqual(dispatch('list', query, ctx), {
+    status: 200,
+    body: {
+      items: [
+        { id: 'a3', label: 'Green Cup', slug: 'green-cup', price: { cents: 850, currency: 'EUR' } },
+        { id: 'a4', label: 'Steel Spoon', slug: 'steel-spoon', price: { cents: 199, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 3,
+      total: 5,
+    },
+  });
+  assert.deepEqual(dispatch('list', query, ctx), listHandler(query, ctx));
+  assert.equal(handlers.list, listHandler);
+});
