diff --git a/tests/slug.test.mjs b/tests/slug.test.mjs
new file mode 100644
index 0000000..c76ab5e
--- /dev/null
+++ b/tests/slug.test.mjs
@@ -0,0 +1,27 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases and joins words with a single dash', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify trims leading and trailing separators', () => {
+  assert.equal(slugify('  --Blue Mug!! '), 'blue-mug');
+});
+
+test('slugify collapses runs of mixed separators into one dash', () => {
+  assert.equal(slugify('Red_ & -/Green...Tea'), 'red-green-tea');
+});
+
+test('slugify keeps digits', () => {
+  assert.equal(slugify('Mug 2 Pack 10'), 'mug-2-pack-10');
+});
+
+test('slugify treats non-ASCII letters as separators', () => {
+  assert.equal(slugify('Café Crème'), 'caf-cr-me');
+});
+
+test('slugify returns an empty string for a label of only separators', () => {
+  assert.equal(slugify(' -_!! - '), '');
+});
