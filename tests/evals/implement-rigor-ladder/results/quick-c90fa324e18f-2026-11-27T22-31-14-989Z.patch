+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..e8f63fc
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,155 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 's3cret-key';
+const PAYLOAD = { sub: 'user-42', role: 'admin' };
+const KNOWN_TOKEN =
+  'eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFkbWluIn0.cnlAwYcBjtsV3YuXbIaOU8nXJ8xlc5L2VhvutFaErbA';
+
+function expectedToken(payload, secret) {
+  const first = Buffer.from(JSON.stringify(payload)).toString('base64url');
+  const sig = createHmac('sha256', secret).update(first).digest('base64url');
+  return `${first}.${sig}`;
+}
+
+test('signToken produces the pinned known token for a fixed payload and secret', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), KNOWN_TOKEN);
+});
+
+test('signToken matches the independently computed base64url(JSON).base64url(HMAC-SHA256) format', () => {
+  const payload = { id: 7, tags: ['a', 'b'], nested: { ok: true } };
+  assert.equal(signToken(payload, 'another-secret'), expectedToken(payload, 'another-secret'));
+});
+
+test('signToken output has exactly two base64url parts with no padding, "+" or "/"', () => {
+  // Payload chosen so standard base64 would contain "+", "/" and "=" padding.
+  const payload = { k: '>>>???~~~', n: 1 };
+  const standard = Buffer.from(JSON.stringify(payload)).toString('base64');
+  assert.match(standard, /[+/=]/);
+  const token = signToken(payload, SECRET);
+  const parts = token.split('.');
+  assert.equal(parts.length, 2);
+  assert.match(parts[0], /^[A-Za-z0-9_-]+$/);
+  assert.match(parts[1], /^[A-Za-z0-9_-]{43}$/);
+  assert.equal(parts[0], Buffer.from(JSON.stringify(payload)).toString('base64url'));
+});
+
+test('verifyToken returns the payload for the pinned known token', () => {
+  assert.deepEqual(verifyToken(KNOWN_TOKEN, SECRET), { sub: 'user-42', role: 'admin' });
+});
+
+test('verifyToken round-trips nested and unicode payloads', () => {
+  const payload = {
+    name: 'Zoë 日本語 🚀',
+    nested: { list: [1, 'two', { three: null }], flag: false },
+    empty: {},
+  };
+  assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), payload);
+});
+
+test('verifyToken round-trips JSON primitive and array payloads', () => {
+  assert.equal(verifyToken(signToken(42, SECRET), SECRET), 42);
+  assert.equal(verifyToken(signToken('hello', SECRET), SECRET), 'hello');
+  assert.deepEqual(verifyToken(signToken([1, 2, 3], SECRET), SECRET), [1, 2, 3]);
+});
+
+test('verifyToken returns null when verified with the wrong secret', () => {
+  assert.equal(verifyToken(KNOWN_TOKEN, 'wrong-secret'), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, 's3cret-keY'), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, ''), null);
+});
+
+test('verifyToken returns null when the payload part is tampered', () => {
+  const [, sig] = KNOWN_TOKEN.split('.');
+  const forgedBody = Buffer.from(JSON.stringify({ sub: 'user-42', role: 'root' })).toString('base64url');
+  assert.equal(verifyToken(`${forgedBody}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null when a single signature character is changed', () => {
+  const [body, sig] = KNOWN_TOKEN.split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.notEqual(flipped, sig);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated signature without throwing', () => {
+  const [body, sig] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig.slice(0, 10)}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig.slice(0, 1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for an extended signature without throwing', () => {
+  const [body, sig] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken(`${body}.${sig}A`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig}${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for an empty string', () => {
+  assert.equal(verifyToken('', SECRET), null);
+});
+
+test('verifyToken returns null for a token with no dot', () => {
+  const [body] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken(body, SECRET), null);
+  assert.equal(verifyToken(KNOWN_TOKEN.replace('.', ''), SECRET), null);
+});
+
+test('verifyToken returns null for tokens with three or more parts', () => {
+  assert.equal(verifyToken(`${KNOWN_TOKEN}.extra`, SECRET), null);
+  assert.equal(verifyToken(`${KNOWN_TOKEN}.`, SECRET), null);
+  assert.equal(verifyToken(`a.${KNOWN_TOKEN}`, SECRET), null);
+  assert.equal(verifyToken('a.b.c.d', SECRET), null);
+});
+
+test('verifyToken returns null for tokens with empty parts', () => {
+  const [body, sig] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken('.', SECRET), null);
+  assert.equal(verifyToken(`${body}.`, SECRET), null);
+  assert.equal(verifyToken(`.${sig}`, SECRET), null);
+  // Empty body correctly signed with the real HMAC must still be rejected.
+  assert.equal(verifyToken(`.${createHmac('sha256', SECRET).update('').digest('base64url')}`, SECRET), null);
+});
+
+test('verifyToken returns null for non-base64url characters in either part', () => {
+  const [body, sig] = KNOWN_TOKEN.split('.');
+  assert.equal(verifyToken(`${body}=.${sig}`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}+`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}/`, SECRET), null);
+  assert.equal(verifyToken(`${body}.${sig}=`, SECRET), null);
+  assert.equal(verifyToken(`${body} .${sig}`, SECRET), null);
+  // Correctly signed first part containing standard-base64 characters.
+  const badBody = 'ab+/cd==';
+  const badSig = createHmac('sha256', SECRET).update(badBody).digest('base64url');
+  assert.equal(verifyToken(`${badBody}.${badSig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed first part that is not valid JSON', () => {
+  const garbage = Buffer.from('not json {').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(garbage).digest('base64url');
+  assert.equal(verifyToken(`${garbage}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed first part that is not base64url-decodable JSON', () => {
+  const garbage = 'zzzz';
+  const sig = createHmac('sha256', SECRET).update(garbage).digest('base64url');
+  assert.equal(verifyToken(`${garbage}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for non-string token inputs without throwing', () => {
+  assert.equal(verifyToken(undefined, SECRET), null);
+  assert.equal(verifyToken(null, SECRET), null);
+  assert.equal(verifyToken(12345, SECRET), null);
+  assert.equal(verifyToken({}, SECRET), null);
+  assert.equal(verifyToken({ split: () => KNOWN_TOKEN.split('.') }, SECRET), null);
+  assert.equal(verifyToken(['a', 'b'], SECRET), null);
+  assert.equal(verifyToken(Buffer.from(KNOWN_TOKEN), SECRET), null);
+});
+
+test('verifyToken returns null for invalid secrets without throwing', () => {
+  assert.equal(verifyToken(KNOWN_TOKEN, undefined), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, null), null);
+  assert.equal(verifyToken(KNOWN_TOKEN, 42), null);
+});
