--- /dev/null
+++ b/tests/slug.test.mjs
@@ -0,0 +1,23 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases and hyphenates words', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify collapses each run of other characters into one hyphen', () => {
+  assert.equal(slugify('Tea  &  Coffee -- Set'), 'tea-coffee-set');
+});
+
+test('slugify trims leading and trailing hyphens', () => {
+  assert.equal(slugify('  ¡Hola, Mundo!  '), 'hola-mundo');
+});
+
+test('slugify keeps digits and replaces non-ASCII letters', () => {
+  assert.equal(slugify('Café 2000'), 'caf-2000');
+});
+
+test('slugify of only separators is empty', () => {
+  assert.equal(slugify('***'), '');
+});
