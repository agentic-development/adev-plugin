+++ b/src/slug.mjs
@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..8778cf8
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,158 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-123';
+const PAYLOAD = { sub: 'user-42', role: 'admin', n: 7 };
+
+function b64url(input) {
+  return Buffer.from(input).toString('base64url');
+}
+
+function expectedToken(payload, secret) {
+  const body = b64url(JSON.stringify(payload));
+  const sig = createHmac('sha256', secret).update(body).digest('base64url');
+  return `${body}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(
+    signToken(PAYLOAD, SECRET),
+    'eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFkbWluIiwibiI6N30.' +
+      createHmac('sha256', SECRET).update('eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFkbWluIiwibiI6N30').digest('base64url'),
+  );
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('verifyToken returns the payload for an independently built valid token', () => {
+  assert.deepEqual(verifyToken(expectedToken(PAYLOAD, SECRET), SECRET), { sub: 'user-42', role: 'admin', n: 7 });
+});
+
+test('verifyToken round-trips a token from signToken', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), { sub: 'user-42', role: 'admin', n: 7 });
+});
+
+test('verifyToken round-trips a unicode payload', () => {
+  const payload = { name: 'Zoë Ñandú', city: '東京', emoji: '🚀', note: 'a+b/c=d' };
+  const token = signToken(payload, SECRET);
+  assert.equal(token, expectedToken(payload, SECRET));
+  assert.deepEqual(verifyToken(token, SECRET), { name: 'Zoë Ñandú', city: '東京', emoji: '🚀', note: 'a+b/c=d' });
+});
+
+test('verifyToken round-trips non-object JSON payloads', () => {
+  assert.equal(verifyToken(signToken('hello', SECRET), SECRET), 'hello');
+  assert.equal(verifyToken(signToken(42, SECRET), SECRET), 42);
+  assert.deepEqual(verifyToken(signToken([1, 'two'], SECRET), SECRET), [1, 'two']);
+});
+
+test('verifyToken returns null for a token signed with a different secret', () => {
+  assert.equal(verifyToken(signToken(PAYLOAD, 'other-secret'), SECRET), null);
+});
+
+test('verifyToken returns null when the payload part is tampered', () => {
+  const [, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const forgedBody = b64url(JSON.stringify({ sub: 'user-42', role: 'superadmin', n: 7 }));
+  assert.equal(verifyToken(`${forgedBody}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature is tampered (same length)', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(flipped.length, sig.length);
+  assert.equal(verifyToken(`${body}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null for a truncated signature without throwing', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig.slice(0, -1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for an over-long signature without throwing', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.${sig}A`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature with a multi-byte character of matching string length', () => {
+  const [body, sig] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(verifyToken(`${body}.é${sig.slice(1)}`, SECRET), null);
+});
+
+const validToken = signToken(PAYLOAD, SECRET);
+const [validBody, validSig] = validToken.split('.');
+
+const malformed = [
+  ['empty string', ''],
+  ['no dot', validBody],
+  ['single dot only', '.'],
+  ['empty body', `.${validSig}`],
+  ['empty signature', `${validBody}.`],
+  ['three parts', `${validToken}.extra`],
+  ['three parts with trailing dot', `${validToken}.`],
+  ['leading dot', `.${validToken}`],
+];
+
+for (const [label, token] of malformed) {
+  test(`verifyToken returns null for malformed token: ${label}`, () => {
+    assert.equal(verifyToken(token, SECRET), null);
+  });
+}
+
+function tokenFromRawBody(rawBody, secret) {
+  const sig = createHmac('sha256', secret).update(rawBody).digest('base64url');
+  return `${rawBody}.${sig}`;
+}
+
+test('verifyToken returns null for a validly signed body that is not JSON', () => {
+  const token = tokenFromRawBody(b64url('not json {'), SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed body that is not valid base64url', () => {
+  const token = tokenFromRawBody('***!!!', SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed body using standard base64 characters', () => {
+  const token = tokenFromRawBody('eyJhIjoxfQ+/', SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed body with a stray non-base64url character that would still decode to JSON', () => {
+  // Node's base64url decoder skips '*', so this body decodes to {"a":1}; the alphabet guard must reject it.
+  const token = tokenFromRawBody('eyJh*IjoxfQ', SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed body with base64 padding', () => {
+  const token = tokenFromRawBody('eyJhIjoxfQ==', SECRET);
+  assert.equal(verifyToken(token, SECRET), null);
+});
+
+for (const [label, token] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['number', 123],
+  ['object', { token: 'x.y' }],
+  ['array', ['a', 'b']],
+  ['Buffer', Buffer.from('a.b')],
+]) {
+  test(`verifyToken returns null for non-string token: ${label}`, () => {
+    assert.equal(verifyToken(token, SECRET), null);
+  });
+}
+
+for (const [label, secret] of [
+  ['absent', undefined],
+  ['null', null],
+  ['number', 42],
+  ['object', { k: 'v' }],
+]) {
+  test(`verifyToken returns null for non-string secret: ${label}`, () => {
+    assert.equal(verifyToken(validToken, secret), null);
+  });
+}
+
+test('verifyToken returns null for an empty-string secret against a token signed with a real secret', () => {
+  assert.equal(verifyToken(validToken, ''), null);
+});
