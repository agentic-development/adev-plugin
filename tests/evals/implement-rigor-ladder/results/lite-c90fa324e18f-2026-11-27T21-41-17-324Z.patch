+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..d497213
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,212 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 's3cret';
+const PAYLOAD = { sub: 'user-1', role: 'admin' };
+// Cross-checked with: openssl dgst -sha256 -hmac s3cret (base64url, unpadded).
+const LITERAL_TOKEN = 'eyJzdWIiOiJ1c2VyLTEiLCJyb2xlIjoiYWRtaW4ifQ.RpJHMy0bMpcYTM7Rt-W1LAhVOSjBY8WHnALyHI-945A';
+
+function expectedToken(payload, secret) {
+  const first = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(first).digest('base64url');
+  return `${first}.${sig}`;
+}
+
+test('signToken produces a known literal token for a fixed payload and secret', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), LITERAL_TOKEN);
+});
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of the first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('signToken first part decodes to the JSON payload', () => {
+  const [first] = signToken(PAYLOAD, SECRET).split('.');
+  assert.equal(Buffer.from(first, 'base64url').toString('utf8'), '{"sub":"user-1","role":"admin"}');
+});
+
+test('signToken output uses only the base64url alphabet (no +, / or =)', () => {
+  // Payload chosen so standard base64 would contain '+', '/' and '=' padding.
+  const payload = { data: '>>>???~~~', n: 1 };
+  const standard = Buffer.from(JSON.stringify(payload)).toString('base64');
+  assert.equal(standard, 'eyJkYXRhIjoiPj4+Pz8/fn5+IiwibiI6MX0=');
+  const token = signToken(payload, SECRET);
+  assert.equal(token, expectedToken(payload, SECRET));
+  assert.equal(/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(token), true);
+});
+
+test('signToken with a different secret produces a different signature', () => {
+  const [, sigA] = signToken(PAYLOAD, SECRET).split('.');
+  const [, sigB] = signToken(PAYLOAD, 'other').split('.');
+  assert.equal(sigB, createHmac('sha256', 'other').update(LITERAL_TOKEN.split('.')[0]).digest('base64url'));
+  assert.notEqual(sigA, sigB);
+});
+
+test('verifyToken returns the payload for the known literal token', () => {
+  assert.deepEqual(verifyToken(LITERAL_TOKEN, SECRET), { sub: 'user-1', role: 'admin' });
+});
+
+for (const [name, payload] of [
+  ['a flat object', { sub: 'user-1', role: 'admin' }],
+  ['a nested object', { user: { id: 7, tags: ['a', 'b'], meta: { active: true, score: null } } }],
+  ['an array', [1, 'two', { three: 3 }, [4]]],
+  ['a string', 'hello world'],
+  ['a number', 42],
+  ['a boolean', false],
+  ['a unicode payload', { name: 'Zoë Ångström', city: '東京', emoji: '🔐✨', rtl: 'שלום' }],
+]) {
+  test(`verifyToken round-trips ${name}`, () => {
+    const token = signToken(payload, SECRET);
+    assert.equal(token, expectedToken(payload, SECRET));
+    assert.deepEqual(verifyToken(token, SECRET), payload);
+  });
+}
+
+const [LITERAL_BODY, LITERAL_SIG] = LITERAL_TOKEN.split('.');
+
+test('verifyToken returns null for a wrong secret', () => {
+  assert.equal(verifyToken(LITERAL_TOKEN, 'wrong-secret'), null);
+});
+
+test('verifyToken returns null for a tampered payload part', () => {
+  const forgedBody = Buffer.from('{"sub":"user-1","role":"root"}', 'utf8').toString('base64url');
+  assert.equal(forgedBody, 'eyJzdWIiOiJ1c2VyLTEiLCJyb2xlIjoicm9vdCJ9');
+  assert.equal(verifyToken(`${forgedBody}.${LITERAL_SIG}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature part of the same length', () => {
+  const tamperedSig = `Q${LITERAL_SIG.slice(1)}`;
+  assert.equal(tamperedSig, 'QpJHMy0bMpcYTM7Rt-W1LAhVOSjBY8WHnALyHI-945A');
+  assert.equal(verifyToken(`${LITERAL_BODY}.${tamperedSig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a non-canonical signature that decodes to the same bytes', () => {
+  // The last base64url char of a 32-byte HMAC carries 2 unused bits: 'A' -> 'B' keeps the bytes.
+  const variantSig = `${LITERAL_SIG.slice(0, -1)}B`;
+  assert.equal(variantSig, 'RpJHMy0bMpcYTM7Rt-W1LAhVOSjBY8WHnALyHI-945B');
+  assert.deepEqual(Buffer.from(variantSig, 'base64url'), Buffer.from(LITERAL_SIG, 'base64url'));
+  assert.equal(verifyToken(`${LITERAL_BODY}.${variantSig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature that is too short', () => {
+  assert.equal(verifyToken(`${LITERAL_BODY}.${LITERAL_SIG.slice(0, -1)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature that is too long', () => {
+  assert.equal(verifyToken(`${LITERAL_BODY}.${LITERAL_SIG}A`, SECRET), null);
+});
+
+test('verifyToken returns null for a signature made with another secret', () => {
+  const otherSig = createHmac('sha256', 'other').update(LITERAL_BODY).digest('base64url');
+  assert.equal(verifyToken(`${LITERAL_BODY}.${otherSig}`, SECRET), null);
+});
+
+function signedRaw(body, secret = SECRET) {
+  return `${body}.${createHmac('sha256', secret).update(body).digest('base64url')}`;
+}
+
+for (const [name, token] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 12345],
+  ['an object', { token: LITERAL_TOKEN }],
+  ['an array', [LITERAL_BODY, LITERAL_SIG]],
+  ['a String object', new String(LITERAL_TOKEN)],
+]) {
+  test(`verifyToken returns null for a non-string token: ${name}`, () => {
+    assert.equal(verifyToken(token, SECRET), null);
+  });
+}
+
+for (const [name, token] of [
+  ['an empty string', ''],
+  ['no separator', `${LITERAL_BODY}${LITERAL_SIG}`],
+  ['only a payload part', LITERAL_BODY],
+  ['more than one separator', `${LITERAL_TOKEN}.extra`],
+  ['two separators with an empty middle part', `${LITERAL_BODY}..${LITERAL_SIG}`],
+  ['an empty payload part', `.${LITERAL_SIG}`],
+  ['an empty signature part', `${LITERAL_BODY}.`],
+  ['a lone separator', '.'],
+  ['surrounding whitespace', ` ${LITERAL_TOKEN} `],
+  ['a padded signature', `${LITERAL_TOKEN}=`],
+]) {
+  test(`verifyToken returns null for a malformed token: ${name}`, () => {
+    assert.equal(verifyToken(token, SECRET), null);
+  });
+}
+
+test('verifyToken returns null for a correctly signed payload part with invalid base64url characters', () => {
+  // Node's lenient decoder would read 'e30*' as '{}'; it must be rejected, not decoded.
+  assert.equal(Buffer.from('e30*', 'base64url').toString('utf8'), '{}');
+  assert.equal(verifyToken(signedRaw('e30*'), SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part with standard base64 padding', () => {
+  assert.equal(Buffer.from('e30=', 'base64url').toString('utf8'), '{}');
+  assert.equal(verifyToken(signedRaw('e30='), SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part of impossible base64 length', () => {
+  assert.equal(verifyToken(signedRaw('A'), SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part that decodes to non-JSON', () => {
+  const body = Buffer.from('not json {', 'utf8').toString('base64url');
+  assert.equal(body, 'bm90IGpzb24gew');
+  assert.equal(verifyToken(signedRaw(body), SECRET), null);
+});
+
+test('verifyToken returns null for a correctly signed payload part that decodes to empty text', () => {
+  const body = Buffer.from('   ', 'utf8').toString('base64url');
+  assert.equal(body, 'ICAg');
+  assert.equal(verifyToken(signedRaw(body), SECRET), null);
+});
+
+for (const [name, secret] of [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 42],
+  ['a plain object', { secret: SECRET }],
+]) {
+  test(`verifyToken returns null for a secret createHmac cannot use: ${name}`, () => {
+    assert.equal(verifyToken(LITERAL_TOKEN, secret), null);
+  });
+}
+
+// Cross-checked with Python hmac (empty key) and openssl dgst -hmac k (base64url, unpadded).
+const EMPTY_SECRET_TOKEN = `${LITERAL_BODY}.ZmLupMA--Xe3oulDd00xSyUzcQf9FeEI0wYDbU3ssdU`;
+const BUFFER_SECRET_TOKEN = `${LITERAL_BODY}.-7kXjGLZUh-Dh6d9-aoemW5zjJVReDMCwlqj2gKWrHY`;
+
+test('signToken with an empty secret produces the known token', () => {
+  assert.equal(signToken(PAYLOAD, ''), EMPTY_SECRET_TOKEN);
+});
+
+test('verifyToken returns the payload for a token signed with an empty secret', () => {
+  assert.deepEqual(verifyToken(EMPTY_SECRET_TOKEN, ''), { sub: 'user-1', role: 'admin' });
+});
+
+test('verifyToken returns null for an empty-secret token checked with a non-empty secret', () => {
+  assert.equal(verifyToken(EMPTY_SECRET_TOKEN, SECRET), null);
+});
+
+test('verifyToken returns null for a non-empty-secret token checked with an empty secret', () => {
+  assert.equal(verifyToken(LITERAL_TOKEN, ''), null);
+});
+
+test('signToken with a Buffer secret produces the known token', () => {
+  assert.equal(signToken(PAYLOAD, Buffer.from('k', 'utf8')), BUFFER_SECRET_TOKEN);
+});
+
+test('verifyToken returns the payload for a token signed with a Buffer secret', () => {
+  assert.deepEqual(verifyToken(BUFFER_SECRET_TOKEN, Buffer.from('k', 'utf8')), { sub: 'user-1', role: 'admin' });
+});
+
+test('verifyToken accepts a Buffer secret with the same bytes as the string secret', () => {
+  assert.deepEqual(verifyToken(LITERAL_TOKEN, Buffer.from(SECRET, 'utf8')), { sub: 'user-1', role: 'admin' });
+});
+
+test('verifyToken returns null for a Buffer-secret token checked with a different Buffer', () => {
+  assert.equal(verifyToken(BUFFER_SECRET_TOKEN, Buffer.from('j', 'utf8')), null);
+});
