+++ b/src/slug.mjs
@@ -0,0 +1,6 @@
+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..15b3bae
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,133 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret';
+const PAYLOAD = { sub: 'user-1', role: 'admin' };
+
+function expectedToken(payload, secret) {
+  const head = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(head).digest('base64url');
+  return `${head}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  assert.equal(signToken(PAYLOAD, SECRET), expectedToken(PAYLOAD, SECRET));
+});
+
+test('signToken matches a known vector derived with openssl', () => {
+  assert.equal(signToken({ a: 1 }, 'k'), 'eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g');
+});
+
+test('verifyToken returns the payload for a token signed with the same secret', () => {
+  assert.deepEqual(verifyToken(signToken(PAYLOAD, SECRET), SECRET), { sub: 'user-1', role: 'admin' });
+});
+
+test('verifyToken accepts an independently constructed token', () => {
+  assert.deepEqual(verifyToken('eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g', 'k'), { a: 1 });
+});
+
+const KNOWN = 'eyJhIjoxfQ.cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g';
+const KNOWN_SIG = 'cd0Z_LfRVHSakSL51JoV0R2QpxIV236jKfi-S1Elq0g';
+
+test('verifyToken returns null when verified with the wrong secret', () => {
+  assert.equal(verifyToken(KNOWN, 'not-k'), null);
+});
+
+test('verifyToken returns null for a tampered payload part with the original signature', () => {
+  const tamperedHead = Buffer.from('{"a":2}', 'utf8').toString('base64url');
+  assert.equal(tamperedHead, 'eyJhIjoyfQ');
+  assert.equal(verifyToken(`${tamperedHead}.${KNOWN_SIG}`, 'k'), null);
+});
+
+test('verifyToken returns null for a same-length tampered signature', () => {
+  const tamperedSig = 'X' + KNOWN_SIG.slice(1);
+  assert.equal(tamperedSig.length, KNOWN_SIG.length);
+  assert.equal(verifyToken(`eyJhIjoxfQ.${tamperedSig}`, 'k'), null);
+});
+
+test('verifyToken returns null for the signature of a different payload', () => {
+  const otherSig = createHmac('sha256', 'k').update('eyJhIjoyfQ').digest('base64url');
+  assert.equal(verifyToken(`eyJhIjoxfQ.${otherSig}`, 'k'), null);
+});
+
+test('verifyToken returns null without throwing for a shorter signature', () => {
+  let result;
+  assert.doesNotThrow(() => { result = verifyToken(`eyJhIjoxfQ.${KNOWN_SIG.slice(0, -1)}`, 'k'); });
+  assert.equal(result, null);
+});
+
+test('verifyToken returns null without throwing for a longer signature', () => {
+  let result;
+  assert.doesNotThrow(() => { result = verifyToken(`eyJhIjoxfQ.${KNOWN_SIG}A`, 'k'); });
+  assert.equal(result, null);
+});
+
+test('verifyToken returns null for a one-byte signature', () => {
+  assert.equal(verifyToken('eyJhIjoxfQ.c', 'k'), null);
+});
+
+const EMPTY_HEAD_SIG = createHmac('sha256', 'k').update('').digest('base64url');
+
+const malformed = [
+  ['an empty string', ''],
+  ['a token with no dot', 'eyJhIjoxfQ'],
+  ['a token with an extra trailing part', `${KNOWN}.extra`],
+  ['a token with an empty trailing part', `${KNOWN}.`],
+  ['a token with an extra leading part', `x.${KNOWN}`],
+  ['a token with an empty payload part', `.${KNOWN_SIG}`],
+  ['a token with an empty payload part and a valid signature over it', `.${EMPTY_HEAD_SIG}`],
+  ['a token with an empty signature part', 'eyJhIjoxfQ.'],
+  ['a lone dot', '.'],
+];
+
+for (const [label, token] of malformed) {
+  test(`verifyToken returns null without throwing for ${label}`, () => {
+    let result;
+    assert.doesNotThrow(() => { result = verifyToken(token, 'k'); });
+    assert.equal(result, null);
+  });
+}
+
+test('verifyToken returns null without throwing for a validly signed first part that is not JSON', () => {
+  const head = Buffer.from('not json', 'utf8').toString('base64url');
+  assert.equal(head, 'bm90IGpzb24');
+  const token = `${head}.${createHmac('sha256', 'k').update(head).digest('base64url')}`;
+  let result;
+  assert.doesNotThrow(() => { result = verifyToken(token, 'k'); });
+  assert.equal(result, null);
+});
+
+test('verifyToken returns null without throwing for a validly signed first part that is not base64url-encoded JSON', () => {
+  const head = '!!!';
+  const token = `${head}.${createHmac('sha256', 'k').update(head).digest('base64url')}`;
+  let result;
+  assert.doesNotThrow(() => { result = verifyToken(token, 'k'); });
+  assert.equal(result, null);
+});
+
+const nonStrings = [
+  ['undefined', undefined],
+  ['null', null],
+  ['a number', 42],
+  ['an object', { token: KNOWN }],
+  ['an array', ['eyJhIjoxfQ', KNOWN_SIG]],
+  ['a boxed string', new String(KNOWN)],
+];
+
+for (const [label, token] of nonStrings) {
+  test(`verifyToken returns null without throwing for ${label} input`, () => {
+    let result;
+    assert.doesNotThrow(() => { result = verifyToken(token, 'k'); });
+    assert.equal(result, null);
+  });
+}
+
+for (const [label, secret] of [['an undefined', undefined], ['a null', null], ['a numeric', 42]]) {
+  test(`verifyToken returns null without throwing for ${label} secret`, () => {
+    let result;
+    assert.doesNotThrow(() => { result = verifyToken(KNOWN, secret); });
+    assert.equal(result, null);
+  });
+}
