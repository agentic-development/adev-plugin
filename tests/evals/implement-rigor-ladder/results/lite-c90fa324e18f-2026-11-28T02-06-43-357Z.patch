@@ -11,3 +11,35 @@ test('a fixed coupon subtracts its amount', () => {
 test('an expired coupon leaves the price unchanged', () => {
   assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: 500 }, NOW), 2000);
 });
+
+test('a coupon expiring exactly at now leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'fixed', amount: 500, expiresAt: NOW }, NOW), 2000);
+});
+
+test('a fixed coupon larger than the price clamps the result to 0', () => {
+  assert.equal(applyDiscount(300, { kind: 'fixed', amount: 500, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('a percent coupon subtracts the floored percentage of the price', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 2_000 }, NOW), 1500);
+});
+
+test('a percent coupon floors a fractional discount before subtracting', () => {
+  // 1999 * 15 / 100 = 299.85 -> floor 299 -> 1999 - 299 = 1700
+  assert.equal(applyDiscount(1999, { kind: 'percent', amount: 15, expiresAt: 2_000 }, NOW), 1700);
+});
+
+test('a percent coupon over 100 clamps the result to 0', () => {
+  assert.equal(applyDiscount(1000, { kind: 'percent', amount: 150, expiresAt: 2_000 }, NOW), 0);
+});
+
+test('an expired percent coupon leaves the price unchanged', () => {
+  assert.equal(applyDiscount(2000, { kind: 'percent', amount: 25, expiresAt: 500 }, NOW), 2000);
+});
+
+test('an unknown coupon kind throws COUPON_INVALID', () => {
+  assert.throws(
+    () => applyDiscount(2000, { kind: 'bogo', amount: 1, expiresAt: 2_000 }, NOW),
+    (err) => err instanceof Error && err.code === 'COUPON_INVALID',
+  );
+});
