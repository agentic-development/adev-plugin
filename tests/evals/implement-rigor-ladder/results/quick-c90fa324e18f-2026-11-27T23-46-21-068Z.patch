diff --git a/tests/handlers/list.test.mjs b/tests/handlers/list.test.mjs
new file mode 100644
index 0000000..a34daa4
--- /dev/null
+++ b/tests/handlers/list.test.mjs
@@ -0,0 +1,64 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { dispatch } from '../../src/registry.mjs';
+import { listHandler } from '../../src/handlers/list.mjs';
+
+const items = [
+  { id: 1, label: 'Red Apple', priceCents: 120 },
+  { id: 2, label: 'Green Pear!', priceCents: 250 },
+  { id: 3, label: '  Big  Banana  ', priceCents: 99 },
+];
+
+test('dispatch("list") returns the first page of formatted items', () => {
+  assert.deepEqual(dispatch('list', { page: 1, pageSize: 2 }, { items, currency: 'USD' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 1, label: 'Red Apple', slug: 'red-apple', price: { cents: 120, currency: 'USD' } },
+        { id: 2, label: 'Green Pear!', slug: 'green-pear', price: { cents: 250, currency: 'USD' } },
+      ],
+      page: 1,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('dispatch("list") returns the right slice for a later page', () => {
+  assert.deepEqual(dispatch('list', { page: 2, pageSize: 2 }, { items, currency: 'EUR' }), {
+    status: 200,
+    body: {
+      items: [
+        { id: 3, label: '  Big  Banana  ', slug: 'big-banana', price: { cents: 99, currency: 'EUR' } },
+      ],
+      page: 2,
+      pageCount: 2,
+      total: 3,
+    },
+  });
+});
+
+test('dispatch("list") with an out-of-range page returns no items', () => {
+  assert.deepEqual(dispatch('list', { page: 3, pageSize: 2 }, { items, currency: 'USD' }), {
+    status: 200,
+    body: { items: [], page: 3, pageCount: 2, total: 3 },
+  });
+});
+
+test('dispatch("list") body has no pageSize key', () => {
+  const { body } = dispatch('list', { page: 1, pageSize: 2 }, { items, currency: 'USD' });
+  assert.deepEqual(Object.keys(body), ['items', 'page', 'pageCount', 'total']);
+  assert.equal(Object.hasOwn(body, 'pageSize'), false);
+});
+
+test('listHandler called directly matches the spec shape', () => {
+  assert.deepEqual(listHandler({ page: 1, pageSize: 3 }, { items: [items[0]], currency: 'GBP' }), {
+    status: 200,
+    body: {
+      items: [{ id: 1, label: 'Red Apple', slug: 'red-apple', price: { cents: 120, currency: 'GBP' } }],
+      page: 1,
+      pageCount: 1,
