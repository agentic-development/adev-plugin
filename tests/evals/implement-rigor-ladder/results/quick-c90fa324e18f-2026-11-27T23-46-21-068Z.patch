diff --git a/src/auth/token.mjs b/src/auth/token.mjs
new file mode 100644
index 0000000..8da4c49
--- /dev/null
+++ b/src/auth/token.mjs
@@ -0,0 +1,37 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+const BASE64URL_PART = /^[A-Za-z0-9_-]+$/;
+
+function sign(data, secret) {
+  return createHmac('sha256', secret).update(data).digest('base64url');
+}
+
+export function signToken(payload, secret) {
+  const head = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  return `${head}.${sign(head, secret)}`;
+}
+
+function isUsableSecret(secret) {
+  return (typeof secret === 'string' || Buffer.isBuffer(secret)) && secret.length > 0;
+}
+
+export function verifyToken(token, secret) {
+  if (typeof token !== 'string' || !isUsableSecret(secret)) return null;
+  const parts = token.split('.');
+  if (parts.length !== 2) return null;
+  const [head, sig] = parts;
+  if (!BASE64URL_PART.test(head) || !BASE64URL_PART.test(sig)) return null;
+
+  // Compare the canonical base64url strings, not decoded bytes: Node's decoder
+  // ignores invalid characters and unused trailing bits, which would let
+  // non-canonical signature encodings verify.
+  const expected = Buffer.from(sign(head, secret), 'utf8');
+  const actual = Buffer.from(sig, 'utf8');
+  if (expected.length !== actual.length || !timingSafeEqual(expected, actual)) return null;
+
+  try {
+    return JSON.parse(Buffer.from(head, 'base64url').toString('utf8'));
+  } catch {
+    return null;
+  }
+}
