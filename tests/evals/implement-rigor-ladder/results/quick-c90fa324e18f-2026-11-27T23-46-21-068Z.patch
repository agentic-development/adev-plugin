+export function slugify(label) {
+  return label
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
diff --git a/tests/auth/token.test.mjs b/tests/auth/token.test.mjs
new file mode 100644
index 0000000..e41d2a5
--- /dev/null
+++ b/tests/auth/token.test.mjs
@@ -0,0 +1,164 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { signToken, verifyToken } from '../../src/auth/token.mjs';
+
+const SECRET = 'test-secret-123';
+
+// Independent reference computation of the BEH-6 token format.
+function expectedToken(payload, secret) {
+  const head = Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+  const sig = createHmac('sha256', secret).update(head).digest('base64url');
+  return `${head}.${sig}`;
+}
+
+test('signToken returns base64url(JSON payload).base64url(HMAC-SHA256 of first part)', () => {
+  const payload = { sub: 'user-1', role: 'admin' };
+  assert.equal(signToken(payload, SECRET), expectedToken(payload, SECRET));
+});
+
+test('signToken matches a known vector computed independently with openssl', () => {
+  assert.equal(
+    signToken({ sub: 'user-1', role: 'admin' }, SECRET),
+    'eyJzdWIiOiJ1c2VyLTEiLCJyb2xlIjoiYWRtaW4ifQ.AZ3wiSikJJeQGhHMIHNfzMw-DmTapsWLfYWOfIvGByk',
+  );
+});
+
+test('signToken handles an empty payload object', () => {
+  assert.equal(signToken({}, SECRET), expectedToken({}, SECRET));
+  assert.equal(signToken({}, SECRET).split('.')[0], 'e30');
+});
+
+test('signToken encodes unicode payloads as UTF-8 base64url', () => {
+  const payload = { name: 'Zoë 日本 🚀' };
+  const token = signToken(payload, SECRET);
+  assert.equal(token, expectedToken(payload, SECRET));
+  assert.equal(token.split('.')[0], Buffer.from('{"name":"Zoë 日本 🚀"}', 'utf8').toString('base64url'));
+});
+
+test('signToken uses base64url alphabet (- and _) with no padding', () => {
+  // '{"a":"??>"}' encodes to base64 'eyJhIjoiPz8+In0=' -> base64url 'eyJhIjoiPz8-In0'
+  // '{"a":"???"}' encodes to base64 'eyJhIjoiPz8/In0=' -> base64url 'eyJhIjoiPz8_In0'
+  assert.equal(signToken({ a: '??>' }, SECRET).split('.')[0], 'eyJhIjoiPz8-In0');
+  assert.equal(signToken({ a: '???' }, SECRET).split('.')[0], 'eyJhIjoiPz8_In0');
+  assert.equal(signToken({ a: '??>' }, SECRET), expectedToken({ a: '??>' }, SECRET));
+});
+
+test('verifyToken returns the payload for a token signed with the same secret', () => {
+  const payload = { sub: 'user-1', role: 'admin', n: 42, tags: ['x', 'y'] };
+  assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), payload);
+});
+
+test('verifyToken returns null for a tampered payload', () => {
+  const token = signToken({ sub: 'user-1', role: 'user' }, SECRET);
+  const sig = token.split('.')[1];
+  const forgedHead = Buffer.from(JSON.stringify({ sub: 'user-1', role: 'admin' }), 'utf8').toString('base64url');
+  assert.strictEqual(verifyToken(`${forgedHead}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a tampered signature of the correct length', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  const [head, sig] = token.split('.');
+  const flipped = (sig[0] === 'A' ? 'B' : 'A') + sig.slice(1);
+  assert.equal(flipped.length, sig.length);
+  assert.strictEqual(verifyToken(`${head}.${flipped}`, SECRET), null);
+});
+
+test('verifyToken returns null when verified with the wrong secret', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  assert.strictEqual(verifyToken(token, 'other-secret'), null);
+});
+
+test('verifyToken returns null for a signature truncated by one character', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  assert.strictEqual(verifyToken(token.slice(0, -1), SECRET), null);
+});
+
+test('verifyToken returns null for a signature that is too long', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  assert.strictEqual(verifyToken(`${token}AAAA`, SECRET), null);
+});
+
+test('verifyToken returns null when the signature contains non-base64url characters', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  // Node's base64url decoder silently skips invalid characters; they must not be accepted.
+  assert.strictEqual(verifyToken(`${token}!`, SECRET), null);
+  assert.strictEqual(verifyToken(`${token}=`, SECRET), null);
+  const [head, sig] = token.split('.');
+  assert.strictEqual(verifyToken(`${head}.${sig.slice(0, 10)}+${sig.slice(11)}`, SECRET), null);
+});
+
+test('verifyToken returns null for a non-canonical signature encoding that decodes to the same bytes', () => {
+  // The known-vector signature is 43 chars; its last char 'k' (index 36) carries 2 unused low bits.
+  // 'l' (index 37) differs only in those unused bits, so it decodes to identical HMAC bytes.
+  const token = 'eyJzdWIiOiJ1c2VyLTEiLCJyb2xlIjoiYWRtaW4ifQ.AZ3wiSikJJeQGhHMIHNfzMw-DmTapsWLfYWOfIvGByk';
+  const variant = `${token.slice(0, -1)}l`;
+  assert.deepEqual(
+    Buffer.from(variant.split('.')[1], 'base64url'),
+    Buffer.from(token.split('.')[1], 'base64url'),
+  );
+  assert.deepEqual(verifyToken(token, SECRET), { sub: 'user-1', role: 'admin' });
+  assert.strictEqual(verifyToken(variant, SECRET), null);
+});
+
+test('verifyToken returns null for non-string tokens without throwing', () => {
+  assert.strictEqual(verifyToken(undefined, SECRET), null);
+  assert.strictEqual(verifyToken(null, SECRET), null);
+  assert.strictEqual(verifyToken(42, SECRET), null);
+  assert.strictEqual(verifyToken({ token: 'a.b' }, SECRET), null);
+  assert.strictEqual(verifyToken(['a', 'b'], SECRET), null);
+});
+
+test('verifyToken returns null for an empty string or a token with no dot', () => {
+  assert.strictEqual(verifyToken('', SECRET), null);
+  assert.strictEqual(verifyToken('eyJzdWIiOiJ1c2VyLTEifQ', SECRET), null);
+});
+
+test('verifyToken returns null for empty parts', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  const [head, sig] = token.split('.');
+  assert.strictEqual(verifyToken('.', SECRET), null);
+  assert.strictEqual(verifyToken(`${head}.`, SECRET), null);
+  assert.strictEqual(verifyToken(`.${sig}`, SECRET), null);
+  // An empty first part carries a valid HMAC of '' — still malformed.
+  const emptyHeadSig = createHmac('sha256', SECRET).update('').digest('base64url');
+  assert.strictEqual(verifyToken(`.${emptyHeadSig}`, SECRET), null);
+});
+
+test('verifyToken returns null for tokens with extra dot segments', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  assert.strictEqual(verifyToken(`${token}.extra`, SECRET), null);
+  assert.strictEqual(verifyToken(`${token}.`, SECRET), null);
+  assert.strictEqual(verifyToken(`a.${token}`, SECRET), null);
+});
+
+test('verifyToken returns null for a validly signed first part that is not valid JSON', () => {
+  const head = Buffer.from('{not json', 'utf8').toString('base64url');
+  const sig = createHmac('sha256', SECRET).update(head).digest('base64url');
+  assert.strictEqual(verifyToken(`${head}.${sig}`, SECRET), null);
+});
+
+test('verifyToken returns null for a missing, non-string, or empty secret without throwing', () => {
+  const token = signToken({ sub: 'user-1' }, SECRET);
+  assert.strictEqual(verifyToken(token, undefined), null);
+  assert.strictEqual(verifyToken(token, null), null);
+  assert.strictEqual(verifyToken(token, 42), null);
+  assert.strictEqual(verifyToken(token, { key: SECRET }), null);
+  assert.strictEqual(verifyToken(token, ''), null);
+  // A token signed with an empty secret must not verify either.
+  assert.strictEqual(verifyToken(expectedToken({ sub: 'user-1' }, ''), ''), null);
+});
+
+test('verifyToken accepts a non-empty Buffer secret matching the signing secret', () => {
+  const key = Buffer.from(SECRET, 'utf8');
+  const token = signToken({ sub: 'user-1' }, key);
+  assert.equal(token, expectedToken({ sub: 'user-1' }, SECRET));
+  assert.deepEqual(verifyToken(token, key), { sub: 'user-1' });
+  assert.strictEqual(verifyToken(token, Buffer.alloc(0)), null);
+});
+
+test('verifyToken round-trips unicode, empty-object, and base64url-character payloads', () => {
+  for (const payload of [{}, { name: 'Zoë 日本 🚀' }, { a: '??>' }, { a: '???' }]) {
+    assert.deepEqual(verifyToken(signToken(payload, SECRET), SECRET), payload);
+  }
+});
