diff --git a/tests/slug.test.mjs b/tests/slug.test.mjs
new file mode 100644
index 0000000..420ae76
--- /dev/null
+++ b/tests/slug.test.mjs
@@ -0,0 +1,27 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { slugify } from '../src/slug.mjs';
+
+test('slugify lowercases and joins words with a dash', () => {
+  assert.equal(slugify('Blue Mug'), 'blue-mug');
+});
+
+test('slugify trims leading and trailing dashes', () => {
+  assert.equal(slugify('  --Blue Mug!!  '), 'blue-mug');
+});
+
+test('slugify collapses each run of non-alphanumerics into a single dash', () => {
+  assert.equal(slugify('Blue   Mug -- 12 oz.'), 'blue-mug-12-oz');
+});
+
+test('slugify keeps digits and lowercases all uppercase input', () => {
+  assert.equal(slugify('MUG2GO'), 'mug2go');
+});
+
+test('slugify treats characters outside a-z0-9 such as accents as separators', () => {
+  assert.equal(slugify('Café_Crème'), 'caf-cr-me');
+});
+
+test('slugify returns an empty string when the label has no alphanumerics', () => {
+  assert.equal(slugify(' !!--?? '), '');
+});
